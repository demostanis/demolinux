pkgname=firefox-bitwarden
pkgver=2026.1.1
pkgrel=14
pkgdesc='Bitwarden browser extension for Firefox'
arch=('any')
url='https://github.com/bitwarden/clients'
license=('GPL-3.0-or-later')
optdepends=('firefox')
groups=('firefox-addons')
pkgdesc='Bitwarden browser extension for Firefox'
makedepends=('nodejs' 'npm' 'unzip' 'zip')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/bitwarden/clients/archive/refs/tags/browser-v${pkgver}.tar.gz" 0001-personal-nitpicks.patch 0002-skip-intro-carousel.patch 0003-remove-premium-spotlight.patch 0004-refresh-fido2-content-scripts-on-unlock.patch 0005-skip-single-passkey-prompts.patch)
