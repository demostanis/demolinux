{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest"
  ],
  "mcp": {
    "firefox": {
      "type": "local",
      "command": [
        "firefox-devtools-mcp", "--firefox-path",
        "/usr/local/bin/firefox-hardened", "--profile-path",
        "/home/demostanis/.mozilla/firefox/default.profile"
      ]
    }
  },
  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/*": "allow"
    }
  },
  "agent": {
    "browser": {
      "prompt": "You are a browser agent specialized in integration testing/QA and scraping. You must use Firefox MCP tools at your disposal for your task.",
      "mode": "subagent",
      "tools": {
        "firefox*": true
      }
    }
  },
  "tools": {
    "firefox*": false
  }
}
