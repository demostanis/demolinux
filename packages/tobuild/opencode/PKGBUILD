# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=opencode
pkgver=1.2.27
_pkgver=1.2.27.6-demolinux
pkgrel=2
pkgdesc='The open source coding agent'
arch=('x86_64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
depends=(
  'curl'
  'gcc-libs'
  'glibc'
  'icu'
  'ripgrep'
  'tar'
)
makedepends=(
  'bun'
  'git'
)
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'xclip: clipboard support on X11'
)
options=(
  '!debug'
  '!strip'
)
_opentui_ver=0.1.79
source=(
  "https://github.com/demostanis/opencode/archive/refs/tags/$_pkgver.tar.gz"
  "opentui-$_opentui_ver.tar.gz::https://github.com/anomalyco/opentui/archive/refs/tags/v$_opentui_ver.tar.gz"
  "fix-motion-events.patch"
  "scrollbar-fix.patch"
)
sha256sums=('ad67a5adfd56d65e86516503a766571efeb99f3814e5ec14b682848c42b9f49d'
            'fea07cc367e9f0ea8831d8908dc7378e59d4e5db5067a3dea28055dff2d166df'
            'b0c3199c7f00c1af06f2d402be5e2e352e10e1289460c968a47f714f4b355bc5'
            'e0c8f07ddd963043f33e1a41ec465a4facd93798f5b92f817bf381c64ac8d187')

prepare() {
  cd "$srcdir/opentui-$_opentui_ver"
  patch -p1 -i "$srcdir/fix-motion-events.patch"
  patch -p1 -i "$srcdir/scrollbar-fix.patch"

  # build opentui/core lib to get parser.worker.js
  cd packages/core
  bun install
  bun run build:lib
  # opencode build script expects parser.worker.js in the package root
  cp dist/parser.worker.js .
  cp dist/parser.worker.js.map .

  cd "$srcdir/opentui-$_opentui_ver"
  cp -ra "packages/core" "$srcdir/$pkgname-$_pkgver/packages/"
  cp -ra "packages/solid" "$srcdir/$pkgname-$_pkgver/packages/"

  cd "$srcdir/$pkgname-$_pkgver"

  sed -i "s/\"packageManager\": \"bun@[^\"]*\"/\"packageManager\": \"bun@$(bun --version)\"/" package.json

  sed -i 's/"@opentui\/core": "[^"]*"/"@opentui\/core": "workspace:*"/' packages/opencode/package.json
  sed -i 's/"@opentui\/solid": "[^"]*"/"@opentui\/solid": "workspace:*"/' packages/opencode/package.json
  sed -i 's/"@opentui\/core": "[^"]*"/"@opentui\/core": "workspace:*"/' packages/solid/package.json

  bun install
}

build() {
  cd $pkgname-$_pkgver/packages/opencode
  OPENCODE_VERSION=$pkgver bun run ./script/build.ts --single --baseline
}

package() {
  cd $pkgname-$_pkgver
  case $CARCH in
  aarch64) dir=opencode-linux-arm64 ;;
  x86_64) dir=opencode-linux-x64-baseline ;;
  esac
  install -vDm755 -t "$pkgdir/usr/bin" "packages/opencode/dist/$dir/bin/opencode"

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  SHELL=/bin/bash "$pkgdir/usr/bin/opencode" completion \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/opencode"
  SHELL=/bin/zsh "$pkgdir/usr/bin/opencode" completion \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_opencode"
}
