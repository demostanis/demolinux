+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mkdir, mkdtemp, readFile, readdir, rm, stat, symlink, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createServer } from 'node:net';
+import { TemporaryFirefoxProfile, findMarionettePort } from '../../src/firefox/profile.js';
+
+describe.runIf(process.platform === 'linux')('Temporary Firefox profiles', () => {
+  let root: string;
+  let template: string;
+
+  beforeEach(async () => {
+    root = await mkdtemp(join(tmpdir(), 'mcp-profile-test-'));
+    template = join(root, 'template with spaces');
+    await mkdir(join(template, 'storage'), { recursive: true });
+    await writeFile(join(template, 'cookies.sqlite'), 'original cookies');
+    await writeFile(join(template, 'storage', 'data'), 'original storage');
+    await writeFile(join(template, 'user.js'), 'original prefs');
+    vi.stubEnv('TMPDIR', root);
+  });
+
+  afterEach(async () => {
+    vi.unstubAllEnvs();
+    await rm(root, { recursive: true, force: true });
+  });
+
+  it('copies the full profile into separate private directories without sharing writes', async () => {
+    const [first, second] = await Promise.all([
+      TemporaryFirefoxProfile.create(template),
+      TemporaryFirefoxProfile.create(template),
+    ]);
+    expect(first.path).not.toBe(second.path);
+    expect(first.path).not.toBe(template);
+    expect(first.path).toContain('rust_mcp-');
+    expect((await stat(first.path)).mode & 0o777).toBe(0o700);
+    expect(await readFile(join(first.path, 'storage', 'data'), 'utf8')).toBe('original storage');
+    await writeFile(join(first.path, 'cookies.sqlite'), 'changed cookies');
+    expect(await readFile(join(template, 'cookies.sqlite'), 'utf8')).toBe('original cookies');
+    expect(await readFile(join(second.path, 'cookies.sqlite'), 'utf8')).toBe('original cookies');
+    await first.remove();
+    await first.remove();
+    expect(await readFile(join(second.path, 'user.js'), 'utf8')).toBe('original prefs');
+  });
+
+  it('excludes lock files, including dangling lock symlinks, but keeps similarly named data', async () => {
+    await symlink('missing-target', join(template, 'lock'));
+    await writeFile(join(template, '.parentlock'), 'lock');
+    await writeFile(join(template, 'parent.lock'), 'lock');
+    await writeFile(join(template, 'storage', 'lock'), 'lock');
+    await writeFile(join(template, 'blocklist.xml'), 'keep');
+    const profile = await TemporaryFirefoxProfile.create(template);
+    const files = await readdir(profile.path);
+    expect(files).not.toContain('lock');
+    expect(files).not.toContain('parent.lock');
+    expect(files).not.toContain('.parentlock');
+    expect(await readdir(join(profile.path, 'storage'))).toEqual(['data']);
+    expect(await readFile(join(profile.path, 'blocklist.xml'), 'utf8')).toBe('keep');
+  });
+
+  it('copies symlink contents instead of exposing writable links to original files', async () => {
+    const shared = join(root, 'shared-prefs');
+    await writeFile(shared, 'original');
+    await symlink(shared, join(template, 'linked-prefs'));
+    const profile = await TemporaryFirefoxProfile.create(template);
+    await writeFile(join(profile.path, 'linked-prefs'), 'changed');
+    expect(await readFile(shared, 'utf8')).toBe('original');
+  });
+
+  it('removes partial copies when preparation fails', async () => {
+    await symlink('missing-target', join(template, 'bad-link'));
+    await expect(TemporaryFirefoxProfile.create(template)).rejects.toThrow();
+    expect((await readdir(root)).filter((name) => name.startsWith('rust_mcp-'))).toEqual([]);
+  });
+
+  it('removes temporary directories when the original profile does not exist', async () => {
+    await expect(TemporaryFirefoxProfile.create(join(root, 'missing'))).rejects.toThrow();
+    expect((await readdir(root)).filter((name) => name.startsWith('rust_mcp-'))).toEqual([]);
+  });
+
+  it('releases the selected loopback port for geckodriver', async () => {
+    const port = await findMarionettePort();
+    expect(port).toBeGreaterThan(0);
+    const server = createServer();
+    try {
+      await new Promise<void>((resolve, reject) => {
+        server.once('error', reject);
+        server.listen(port, '127.0.0.1', resolve);
+      });
+    } finally {
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+    }
+  });
+});
