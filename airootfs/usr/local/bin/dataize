#!/usr/bin/env bash

set -e

if [ "$(id -u)" != 0 ]; then
	echo You need root
	exit 1
fi

file=${1:-missing file}
file=$(echo "$file" | sed 's%/*$%%')

if ! [ -d "$file" -o -f "$file" ]; then
	echo only directories and files are supported >&2
	exit 1
fi
if [ -L "$file" ]; then
	echo only directories and files are supported >&2
	exit 1
fi

persisted=/run/archiso/persistfs/upperdir$(realpath -ms -- "$file")
if [[ -d "$persisted" && ! -L "$persisted" ]]; then
	printf 'Directory already in persistfs: %s; remove the saved entry explicitly first.\n' "$file" >&2
	exit 1
fi

dest=/data/$(realpath "$file" | tr / _)
if [ -d "$file" ]; then
	mkdir -vp "$dest"
else
	touch "$dest"
fi
chmod --reference="$file" -- "$dest"
chown --reference="$file" -- "$dest"
if [ -d "$file" ]; then
	cp -va -- "$file"/* "$dest" || :
	cp -va -- "$file"/.* "$dest" || :
else
	cp -va -- "$file" "$dest"
fi
rm -vrf -- "$file"
ln -vs -- "$dest" "$file"
chown -h --reference="$dest" -- "$file"
persistfs add "$file"
