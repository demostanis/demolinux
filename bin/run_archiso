#!/usr/bin/env bash
#
# Copyright (C) 2020 David Runge <dvzrv@archlinux.org>
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# A simple script to run an archiso image using qemu. The image can be booted
# using BIOS or UEFI.
#
# Requirements:
# - qemu
# - passt
# - edk2-ovmf (when UEFI booting)


set -eu

print_help() {
    local usagetext
    IFS='' read -r -d '' usagetext <<EOF || true
Usage:
    run_archiso [options]

Options:
    -a              set accessibility support using brltty
    -b              set boot type to 'BIOS' (default)
    -d              boot from hard disk (default)
    -h              print help
    -i [image]      image to boot into
    -H              run headless (-nographic)
    -T [size]       truncate image to specific size
    -S              use a temporary qcow2 overlay (leave the image untouched)
    -N [backend]    network backend: passt (default) or user
    -s              use Secure Boot (only relevant when using UEFI)
    -u              set boot type to 'UEFI'
    -v              use VNC display (instead of default SDL)
    -c [image]      attach an additional optical disc image (e.g. for cloud-init)

Example:
    Run an image using UEFI:
    $ run_archiso -u -i archiso-2020.05.23-x86_64.iso
EOF
    printf '%s' "${usagetext}"
}

cleanup_working_dir() {
    if [[ -n "${qemu_pid:-}" ]]; then
        kill "${qemu_pid}" 2>/dev/null || true
        wait "${qemu_pid}" 2>/dev/null || true
    fi
    if [[ -n "${passt_pid:-}" ]]; then
        kill "${passt_pid}" 2>/dev/null || true
        wait "${passt_pid}" 2>/dev/null || true
    fi
    if [[ -d "${working_dir}" ]]; then
        rm -rf -- "${working_dir}"
    fi
}

start_passt() {
    local passt_socket="${working_dir}/passt.socket"

    if ! command -v passt >/dev/null; then
        printf 'ERROR: %s\n' 'passt not found. Install passt.'
        exit 1
    fi

    passt --foreground --quiet --one-off \
        --socket "${passt_socket}" --tcp-ports "${DEMOLINUX_SSH_PORT:-60022}:22" &
    passt_pid=$!

    for _ in {1..50}; do
        if [[ -S "${passt_socket}" ]]; then
            network_options=(
                '-netdev' "stream,id=net0,server=off,addr.type=unix,addr.path=${passt_socket}"
            )
            return
        fi
        if ! kill -0 "${passt_pid}" 2>/dev/null; then
            wait "${passt_pid}" || true
            printf 'ERROR: %s\n' 'passt exited before creating its socket.'
            exit 1
        fi
        sleep 0.1
    done

    printf 'ERROR: %s\n' 'Timed out waiting for passt socket.'
    exit 1
}

copy_ovmf_vars() {
    if [[ ! -f '/usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd' ]]; then
        printf 'ERROR: %s\n' "OVMF_VARS.4m.fd not found. Install edk2-ovmf."
        exit 1
    fi
    cp -av -- '/usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd' "${working_dir}/"
}

check_image() {
    if [[ -z "$image" ]]; then
        printf 'ERROR: %s\n' "Image name can not be empty."
        exit 1
    fi
    if [[ ! -f "$image" ]]; then
        printf 'ERROR: %s\n' "Image file (${image}) does not exist."
        exit 1
    fi
}

truncate_image() {
    if [[ "$snapshot" == y ]]; then
        qemu-img create -q -f qcow2 -F raw -b "$(realpath -- "$image")" "${working_dir}/disk.qcow2"
        image="${working_dir}/disk.qcow2"
        image_format=qcow2
        if [[ -n "$truncatesize" ]]; then
            qemu-img resize -q "$image" "$truncatesize"
        fi
    elif [ -n "$truncatesize" ]; then
        truncate -s "$truncatesize" "$image"
    fi
}

run_image() {
    case "$network_backend" in
        passt) start_passt ;;
        user)
            network_options=(
                -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:${DEMOLINUX_SSH_PORT:-60022}-:22"
            )
            ;;
        *) printf 'ERROR: Unknown network backend: %s\n' "$network_backend" >&2; exit 1 ;;
    esac

    if [[ "$boot_type" == 'uefi' ]]; then
        copy_ovmf_vars
        if [[ "${secure_boot}" == 'on' ]]; then
            printf '%s\n' 'Using Secure Boot'
            local ovmf_code='/usr/share/edk2-ovmf/x64/OVMF_CODE.secboot.4m.fd'
        else
            local ovmf_code='/usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd'
        fi
        qemu_options+=(
            '-drive' "if=pflash,format=raw,unit=0,file=${ovmf_code},read-only=on"
            '-drive' "if=pflash,format=raw,unit=1,file=${working_dir}/OVMF_VARS.4m.fd"
            '-global' "driver=cfi.pflash01,property=secure,value=${secure_boot}"
        )
    fi

    if [[ "${accessibility}" == 'on' ]]; then
        qemu_options+=(
            '-chardev' 'braille,id=brltty'
            '-device' 'usb-braille,id=usbbrl,chardev=brltty'
        )
    fi

    if [[ -n "${oddimage}" ]]; then
        qemu_options+=(
            '-device' 'scsi-cd,bus=scsi0.0,drive=cdrom1'
            '-drive' "id=cdrom1,if=none,format=raw,media=cdrom,read-only=on,file=${oddimage}"
        )
    fi

    if [ "$headless" = y ]; then
        display=none
        qemu_options+=( -monitor none )
    fi

    qemu-system-x86_64 \
        -boot "order=${boot_order},menu=on,reboot-timeout=5000" \
        -m "${DEMOLINUX_VM_MEMORY:-3072}" \
        -smp "${DEMOLINUX_VM_CPUS:-1}" \
        -k en-us \
        -name archiso,process=archiso_0 \
        -drive "format=${image_format},file=${image}" \
        -display "${display}" \
        -vga virtio \
        -device virtio-net-pci,romfile=,netdev=net0 \
        "${network_options[@]}" \
        -qmp "tcp:127.0.0.1:${DEMOLINUX_QMP_PORT:-4444},server=on,wait=off" \
        -machine type=q35,smm=on,accel=kvm,usb=on \
        -cpu max -enable-kvm \
        -serial stdio \
        "${qemu_options[@]}" &
    qemu_pid=$!
    # A dead network helper is a failed VM, not a four-minute SSH timeout.
    if [[ -n "$passt_pid" ]]; then
        local finished result=0
        wait -n -p finished "$qemu_pid" "$passt_pid" || result=$?
        if [[ "$finished" == "$passt_pid" ]] && kill -0 "$qemu_pid" 2>/dev/null; then
            if (( result == 0 )); then
                # --one-off can finish just before QEMU exits on guest shutdown.
                wait "$qemu_pid"
                return
            fi
            printf 'ERROR: passt exited while QEMU was running.\n' >&2
            return 1
        fi
        return "$result"
    fi
    wait "$qemu_pid"
}

image=''
oddimage=''
accessibility=''
boot_type='bios'
boot_order=c
secure_boot='off'
headless='n'
display='gtk,show-cursor=on'
qemu_options=()
network_options=()
passt_pid=''
qemu_pid=''
snapshot=n
image_format=raw
network_backend="${DEMOLINUX_NETWORK_BACKEND:-passt}"
working_dir="$(mktemp -dt run_archiso.XXXXXXXXXX)"
truncatesize=''
trap cleanup_working_dir EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if (( ${#@} > 0 )); then
    while getopts 'abc:dhHi:T:SN:suv' flag; do
        case "$flag" in
            a)
                accessibility='on'
                ;;
            b)
                boot_type='bios'
                ;;
            c)
                oddimage="$OPTARG"
                ;;
            d)
                boot_order=c
                ;;
            h)
                print_help
                exit 0
                ;;
            H)
                headless='y'
                ;;
            i)
                image="$OPTARG"
                ;;
            u)
                boot_type='uefi'
                ;;
            s)
                secure_boot='on'
                ;;
            T)
                truncatesize="$OPTARG"
                ;;
            S)
                snapshot=y
                ;;
            N)
                network_backend="$OPTARG"
                ;;
            v)
                display='none'
                qemu_options+=(-vnc 'vnc=0.0.0.0:0,vnc=[::]:0')
                ;;
            *)
                printf '%s\n' "Error: Wrong option. Try 'run_archiso -h'."
                exit 1
                ;;
        esac
    done
else
    print_help
    exit 1
fi

check_image
truncate_image
run_image
