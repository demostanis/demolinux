#!/bin/bash

expectnofocus() {
	expectawesome 'return client.focus == nil'
}

# overview used to have an issue where the focused window
# would be out of view
expectfocusandleftmost() {
	expectawesome 'return overview_shown ~= true'
	expectfocus "$1"
	expectviewport
}

spawndummywin() {
	yad --class="nonfloating" --title="$1" &
	expectwin "$1"
	expectfocus "$1"
	expectviewport
}

openoverview() {
	modkeypress o
	expectawesome 'return overview_shown == true'
}

expectawesome 'return #client.get() == 0'

# Hosted sidewindows belong to their OpenCode window, not the overview grid.
spawndummywin "owner"
spawndummywin "sidewindow"
awesome-client 'client.focus.opencode_sidecar_hosted = true' >/dev/null
modkeypress o
expectawesome 'return overview_shown ~= true'
quitwin
spawndummywin "window 2"
spawndummywin "sidewindow"
awesome-client 'client.focus.opencode_sidecar_hosted = true' >/dev/null
openoverview
xdotool key j
expectfocusandleftmost "window 2"
awesome-client 'for _, c in ipairs(client.get()) do if c.opencode_sidecar_hosted then c:kill() end end' >/dev/null
expectawesome 'for _, c in ipairs(client.get()) do if c.opencode_sidecar_hosted then return false end end return true'
quitwin
expectfocusandleftmost "owner"
quitwin
expectawesome 'return #client.get() == 0'
modkeypress o
expectawesome 'return overview_shown ~= true'
expectnofocus

# The real hosted app disappears while its owner preview includes the sidewindow.
urxvt -title "OC | overview owner" -e sleep 120 &
expectwin "OC | overview owner"
spawndummywin "overview hosted app"
spawndummywin "overview spacer"
awesome-client '
    local owner, hosted
    for _, c in ipairs(client.get()) do
        if c.name == "OC | overview owner" then owner = c end
        if c.name == "overview hosted app" then hosted = c end
    end
    local sidecar = require"opencode_sidecar"
    sidecar.capture_window(owner, hosted.window, "Overview app")
    sidecar.show(owner)
' >/dev/null
expectawesome '
    for _, c in ipairs(client.get()) do
        if c.name == "OC | overview owner" then
            local parts = require"opencode_sidecar".overview_parts(c)
            return #parts == 2 and parts[2].geometry.width > 1
        end
    end
    return false
'
openoverview
expectawesome '
    for _, c in ipairs(client.get()) do
        if c.opencode_sidecar_hosted then return c.hidden end
    end
    return false
'
xdotool key Escape
expectawesome 'return overview_shown ~= true'
expectawesome '
    for _, c in ipairs(client.get()) do
        if c.opencode_sidecar_hosted then return not c.hidden end
    end
    return false
'
awesome-client 'for _, c in ipairs(client.get()) do c:kill() end' >/dev/null
expectawesome 'return #client.get() == 0'

spawndummywin "single window"
modkeypress o
expectawesome 'return overview_shown ~= true'
expectfocusandleftmost "single window"
quitwin
expectawesome 'return #client.get() == 0'

spawndummywin "window 1"
spawndummywin "window 2"

awesome-client '
    overview_visible_previews = function()
        local count = 0
        for _, d in ipairs(drawin.get()) do
            if d.visible and d:get_xproperty("WM_NAME") == "overview_client_preview" then
                count = count + 1
            end
        end
        return count
    end
    for _, c in ipairs(client.get()) do
        if c.name == "window 2" then c.minimized = true end
    end
    require"overview"()
    overview_entry_previews = overview_visible_previews()
' >/dev/null
expectawesome 'return overview_shown and overview_entry_previews == 1'
expectawesome 'return overview_visible_previews() == 2'
awesome-client '
    awesome.emit_signal("overview::hide")
    overview_exit_previews = overview_visible_previews()
' >/dev/null
expectawesome 'return overview_exit_previews == 1'
expectawesome 'return overview_shown ~= true'
expectawesome '
    for _, c in ipairs(client.get()) do
        if c.name == "window 2" then return c.minimized end
    end
    return false
'
awesome-client '
    overview_visible_previews = nil
    overview_entry_previews = nil
    overview_exit_previews = nil
    for _, c in ipairs(client.get()) do
        if c.name == "window 2" then
            c.minimized = false
            c:activate { context = "test", raise = true }
        end
    end
' >/dev/null
expectfocusandleftmost "window 2"

awesome-client '
overview_activation = nil
overview_activation_handler = function(c, context, hints)
    if context == "overview" and hints.raise then overview_activation = c.name end
end
client.connect_signal("request::activate", overview_activation_handler)
' >/dev/null
openoverview
xdotool key f
expectfocusandleftmost "window 1"
expectawesome 'return overview_activation == "window 1"'

openoverview
xdotool key j
expectfocusandleftmost "window 2"
expectawesome 'return overview_activation == "window 2"'
awesome-client 'client.disconnect_signal("request::activate", overview_activation_handler); overview_activation_handler = nil; overview_activation = nil' >/dev/null

# no results
openoverview
xdotool key space
expectnofocus
xdotool key BackSpace
xdotool key j
expectfocusandleftmost "window 2"

quitwin
expectfocusandleftmost 'window 1'
quitwin
expectawesome 'return #client.get() == 0'

# more windows than fjdksla, so we get fffjfd..
for i in {1..8}; do
	spawndummywin "dummy $i"
done
openoverview
xdotool key f
expectnofocus
xdotool key f
expectfocusandleftmost 'dummy 1'
for i in {1..8}; do
	quitwin
done
expectawesome 'return #client.get() == 0'
