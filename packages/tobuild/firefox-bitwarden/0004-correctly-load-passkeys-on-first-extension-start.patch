+  /**
+   * Handles the case where the user clicks a passkey in the inline menu but no active FIDO2
+   * request exists for the tab. This can happen on a fresh extension load (e.g., Firefox startup
+   * with restored tabs) because the page's `navigator.credentials.get()` call happened before
+   * our FIDO2 page script could be injected and override it.
+   *
+   * We recover by silently reloading the tab (at which point our scripts are guaranteed to be
+   * injected in time) and auto-continuing with the chosen credential once a new active request
+   * is registered, so the user experiences a single-click passkey auth.
+   *
+   * @param sender - The sender of the port message
+   * @param credentialId - The credential ID the user selected
+   */
+  private schedulePendingPasskeyAuthentication(
+    sender: chrome.runtime.MessageSender,
+    credentialId: string,
+  ) {
+    const tabId = sender.tab.id;
+    const tabUrl = sender.tab.url;
+    this.pendingFido2PasskeyByTabId.set(tabId, credentialId);
+
+    // Give the page a reasonable window to re-request credentials after reload before giving up.
+    const pendingTimeoutMs = 15000;
+    this.fido2ActiveRequestManager
+      .getActiveRequest$(tabId)
+      .pipe(
+        filter((activeRequest) => activeRequest !== undefined),
+        take(1),
+        takeUntil(timer(pendingTimeoutMs)),
+      )
+      .subscribe({
+        next: (activeRequest) => {
+          const pendingCredentialId = this.pendingFido2PasskeyByTabId.get(tabId);
+          this.pendingFido2PasskeyByTabId.delete(tabId);
+          if (!pendingCredentialId) {
+            return;
+          }
+          chrome.webRequest.onCompleted.addListener(this.handlePasskeyAuthenticationOnCompleted, {
+            urls: generateDomainMatchPatterns(tabUrl),
+          });
+          // Defer to the next microtask so that `newActiveRequest` in
+          // `Fido2ActiveRequestManager` has a chance to subscribe to `activeRequest.subject`
+          // via `firstValueFrom` before we emit. Subjects don't replay, so emitting synchronously
+          // here (while we are still inside the `activeRequests$.next(...)` call that triggered
+          // this subscription) would drop the event and leave `firstValueFrom` hanging forever.
+          queueMicrotask(() => {
+            activeRequest.subject.next({
+              type: Fido2ActiveRequestEvents.Continue,
+              credentialId: pendingCredentialId,
+            });
+          });
+        },
+        complete: () => {
+          this.pendingFido2PasskeyByTabId.delete(tabId);
+        },
+      });
+
+    this.closeInlineMenu(sender, { forceCloseInlineMenu: true });
+    BrowserApi.reloadTab(tabId).catch((error) => this.logService.error(error));
+  }
+
   /**
