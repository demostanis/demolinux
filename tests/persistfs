#!/bin/bash

# tests/run sources this file in zsh; execute the suite in Bash either way.
sudo bash <<'BASH'
set -Eeuo pipefail
systemd-detect-virt --vm --quiet || { echo 'Run in a disposable VM' >&2; exit 1; }

upper=/run/archiso/persistfs/upperdir
index=$upper/index
root=
packages=()
extra_paths=()
export TERM=xterm

pfs() {
	timeout 30 persistfs "$@" > "$root/stdout" 2> "$root/stderr"
}

expect_failure() {
	if "$@"; then
		printf 'Expected failure: %s\n' "$*" >&2
		return 1
	fi
}

read_index() {
	pfs list --all --null
	mapfile -d '' -t entries < "$root/stdout"
}

index_count() {
	local entry count=0
	for entry in "${entries[@]}"; do
		[[ "$entry" != "$1" ]] || count=$((count + 1))
	done
	[[ "$count" = "$2" ]]
}

cleanup_case() {
	[[ -n "$root" ]] || return 0
	if (( ${#packages[@]} )); then
		pacman -Rdd --noconfirm "${packages[@]}" >/dev/null 2>&1 || :
	fi
	if (( ${#extra_paths[@]} )); then
		rm -rf -- "${extra_paths[@]}"
	fi
	rm -rf -- "$saved" "$root"
	root=
}

fail() {
	printf 'FAIL: %s, line %s: %s\n' "${test:-setup}" "$1" "$2" >&2
	if [[ -n "$root" ]]; then
		cat "$root/stdout" "$root/stderr" "$root"/*.log >&2 2>/dev/null || :
	fi
}

trap 'fail "$LINENO" "$BASH_COMMAND"' ERR
trap cleanup_case EXIT

test_basic_file() {
	printf 'payload\n' > "$root/file"
	pfs add "$root/file"
	cmp "$root/file" "$saved/file"
	pfs add "$root/file"
	cmp "$root/file" "$saved/file"
	pfs remove "$root/file"
	[[ ! -e "$saved/file" && -f "$root/file" ]]
	expect_failure pfs add "$root/missing" "$root/file"
	[[ ! -e "$saved/file" && ! -e "$saved/missing" ]]
}

test_basic_directory() {
	mkdir -p "$root/a/b/c"
	pfs add "$root/a"
	[[ -d "$saved/a/b/c" ]]
	pfs remove "$root/a/b/c"
	[[ ! -e "$saved/a/b/c" && -d "$saved/a/b" ]]
	[[ -d "$root/a/b/c" ]]
}

test_basic_symlink() {
	mkdir "$root/target"
	ln -s target "$root/link"
	pfs add "$root/link"
	[[ -L "$saved/link" && $(readlink "$saved/link") = target ]]
	pfs remove "$root/link"
	[[ ! -L "$saved/link" && -L "$root/link" ]]
}

test_package_install() {
	systemctl start pacman-init
	# Ignore yes's SIGPIPE, but retain the exit status of pfs.
	set +o pipefail
	yes | pfs ipkg wildcard
	set -o pipefail
	[[ -x "$upper/usr/bin/wildcard" ]]
	[[ $(stat -c '%a:%u:%g' /usr/bin/wildcard) = $(stat -c '%a:%u:%g' "$upper/usr/bin/wildcard") ]]
}

test_remove_cannot_escape_upperdir() {
	local victim="${upper%/*}/${root##*/}"
	extra_paths+=( "$victim" )
	printf 'outside\n' > "$victim"
	expect_failure pfs remove "/../${victim##*/}"
	[[ $(< "$victim") = outside ]]
}

test_symlink_ancestor_cannot_delete_source() {
	local link="$upper/${root##*/}"
	extra_paths+=( "$link" )
	printf 'payload\n' > "$root/victim"
	ln -s "$root" "$link"
	expect_failure pfs remove "/${link##*/}/victim"
	[[ $(< "$root/victim") = payload ]]
}

test_root_is_reserved() {
	expect_failure pfs remove /
	expect_failure pfs add /
}

test_failed_copy_returns_failure_without_indexing() {
	touch "$root/cannot-copy"
	expect_failure timeout 30 unshare --mount bash -ec '
		mount --make-rprivate /
		mount --bind "$1" "$1"
		mount -o remount,bind,ro "$1"
		exec persistfs add "$2"
	' bash "$upper" "$root/cannot-copy" > "$root/stdout" 2> "$root/stderr"
	grep -Fq rsync "$root/stderr"
	[[ ! -e "$saved/cannot-copy" ]]
	if [[ -f "$index" ]]; then
		! grep -aFq -- "$root/cannot-copy" "$index"
	fi
}

test_concurrent_index_updates() {
	local i pid
	local -a pids=() paths=()
	touch "$root/same-file"
	for i in {1..16}; do
		timeout 30 persistfs add "$root/same-file" > "$root/add-$i.log" 2>&1 &
		pids+=( "$!" )
	done
	for pid in "${pids[@]}"; do wait "$pid"; done
	pfs list --all
	[[ $(grep -Fxc -- "$root/same-file" "$root/stdout") = 1 ]]
	for i in {01..16}; do
		touch "$root/file-$i"
		paths+=( "$root/file-$i" )
	done
	pfs add "${paths[@]}"
	pids=()
	for i in "${!paths[@]}"; do
		timeout 30 persistfs remove "${paths[$i]}" > "$root/remove-$i.log" 2>&1 &
		pids+=( "$!" )
	done
	for pid in "${pids[@]}"; do wait "$pid"; done
	pfs list --all
	for i in "${paths[@]}"; do
		! grep -Fxq -- "$i" "$root/stdout"
	done
}

test_metadata_and_hardlinks_survive() {
	printf 'payload\n' > "$root/metadata"
	ln "$root/metadata" "$root/hardlink"
	setfattr -n user.persistfs-test -v keep "$root/metadata"
	setfacl -m u:demostanis:r-- "$root/metadata"
	setcap cap_net_bind_service=ep "$root/metadata"
	pfs add "$root/metadata" "$root/hardlink"
	getfacl -cp "$root/metadata" > "$root/source-acl"
	getfacl -cp "$saved/metadata" > "$root/saved-acl"
	cmp "$root/source-acl" "$root/saved-acl"
	local attr
	for attr in user.persistfs-test security.capability; do
		getfattr --absolute-names --only-values -n "$attr" "$root/metadata" > "$root/source-attr"
		getfattr --absolute-names --only-values -n "$attr" "$saved/metadata" > "$root/saved-attr"
		cmp "$root/source-attr" "$root/saved-attr"
	done
	[[ "$saved/metadata" -ef "$saved/hardlink" ]]
}

test_index_matches_whole_paths() {
	touch "$root/prefix" "$root/prefix-long" "$root/square[1]"
	pfs add "$root/prefix-long" "$root/prefix" "$root/square[1]" "$root/square[1]"
	read_index
	index_count "$root/prefix" 1
	index_count "$root/square[1]" 1
	pfs remove "$root/prefix"
	read_index
	index_count "$root/prefix" 0
	index_count "$root/prefix-long" 1
}

test_unusual_filenames_roundtrip() {
	local name
	local -a paths=()
	for name in 'space name' "quote'name" 'back\slash' $'line\nbreak' $'trailing\n' $'parent\n/child\n'; do
		if [[ "$name" = */* ]]; then
			mkdir -p -- "$root/${name%/*}"
		fi
		touch -- "$root/$name"
		paths+=( "$root/$name" )
	done
	pfs add "${paths[@]}"
	pfs list --null
	mapfile -d '' -t entries < "$root/stdout"
	for name in "${paths[@]}"; do
		[[ -f "$upper$name" ]]
		index_count "$name" 1
	done
	pfs remove "${paths[@]}"
	read_index
	for name in "${paths[@]}"; do index_count "$name" 0; done
}

test_normalized_remove_updates_index() {
	touch "$root/relative-dot"
	pfs add "$root/relative-dot"
	pfs remove "$root/./relative-dot"
	read_index
	index_count "$root/relative-dot" 0
}

test_index_normalizes_directory_spellings() {
	mkdir "$root/dir"
	pfs add "$root/dir" "$root/dir/." "$root/dir/"
	read_index
	index_count "$root/dir" 1
	index_count "$root/dir/." 0
	index_count "$root/dir/" 0
}

test_legacy_index_migration() {
	touch "$root/legacy"
	printf '%s\n' "$root/legacy" "$root/./legacy" > "$index"
	printf '%s\0' "$root/legacy" > "$root/expected-index"
	pfs list --all --null
	cmp "$root/expected-index" "$root/stdout"
	pfs add "$root/legacy"
	cmp "$root/expected-index" "$index"
}

for test in \
	test_basic_file \
	test_basic_directory \
	test_basic_symlink \
	test_package_install \
	test_remove_cannot_escape_upperdir \
	test_symlink_ancestor_cannot_delete_source \
	test_root_is_reserved \
	test_failed_copy_returns_failure_without_indexing \
	test_concurrent_index_updates \
	test_metadata_and_hardlinks_survive \
	test_index_matches_whole_paths \
	test_unusual_filenames_roundtrip \
	test_normalized_remove_updates_index \
	test_index_normalizes_directory_spellings \
	test_legacy_index_migration
do
	root=$(mktemp -d /tmp/pfs-test.XXXXXXXX)
	saved=$upper$root
	packages=()
	extra_paths=()
	"$test"
	printf 'PASS: %s\n' "$test"
	cleanup_case
done
BASH
