+void CaptureWidget::initExternalActions()
+{
+    const auto actions = loadExternalActions();
+    if (actions.isEmpty()) {
+        return;
+    }
+    m_externalActionRunner = new ExternalActionRunner(this);
+    m_externalActionsButton = new QToolButton(this);
+    m_externalActionsButton->setObjectName("externalActionsButton");
+    m_externalActionsButton->setText(tr("External actions"));
+    m_externalActionsButton->setPopupMode(QToolButton::InstantPopup);
+    m_externalActionsButton->setAttribute(Qt::WA_NoMousePropagation);
+    auto* menu = new QMenu(m_externalActionsButton);
+    m_externalActionsButton->setMenu(menu);
+    for (const auto& action : actions) {
+        auto* item = menu->addAction(QIcon::fromTheme(action.icon), action.name);
+        item->setShortcut(QKeySequence(action.shortcut, QKeySequence::PortableText));
+        item->setShortcutContext(Qt::WidgetWithChildrenShortcut);
+        addAction(item);
+        connect(item, &QAction::triggered, this, [this, action]() {
+            runExternalAction(action);
+        });
+    }
+    menu->addSeparator();
+    auto* cancel = menu->addAction(tr("Cancel running action"));
+    cancel->setEnabled(false);
+    connect(cancel, &QAction::triggered, m_externalActionRunner, &ExternalActionRunner::cancel);
+    connect(menu, &QMenu::aboutToShow, this, [this, menu, cancel]() {
+        for (auto* item : menu->actions()) {
+            item->setEnabled(!m_externalActionRunner->running());
+        }
+        cancel->setEnabled(m_externalActionRunner->running());
+    });
+    connect(m_externalActionRunner, &ExternalActionRunner::finished, this,
+            [this, menu, cancel](bool success, const QString& message) {
+        for (auto* item : menu->actions()) {
+            item->setEnabled(true);
+        }
+        cancel->setEnabled(false);
+        if (success) {
+            m_captureDone = true;
+            close();
+        } else {
+            showExternalActionMessage(message);
+        }
+    });
+    makeChild(m_externalActionsButton);
+    m_externalActionsButton->adjustSize();
+    m_externalActionsButton->move(
+      mapFromGlobal(QGuiAppCurrentScreen().currentScreen()->geometry().topLeft()) + QPoint(12, 12));
+    m_externalActionsButton->show();
+    m_externalActionsButton->raise();
+    m_externalActionsStatus = new QLabel(this);
+    m_externalActionsStatus->setObjectName("externalActionsStatus");
+    m_externalActionsStatus->setTextFormat(Qt::PlainText);
+    m_externalActionsStatus->setWordWrap(true);
+    m_externalActionsStatus->setMargin(8);
+    m_externalActionsStatus->setFixedWidth(qMin(420, width() - 24));
+    m_externalActionsStatus->setAutoFillBackground(true);
+    auto palette = m_externalActionsStatus->palette();
+    palette.setColor(QPalette::Window, palette.color(QPalette::ToolTipBase));
+    palette.setColor(QPalette::WindowText, palette.color(QPalette::ToolTipText));
+    m_externalActionsStatus->setPalette(palette);
+    m_externalActionsStatus->setAttribute(Qt::WA_TransparentForMouseEvents);
+    auto* statusTimer = new QTimer(m_externalActionsStatus);
+    statusTimer->setSingleShot(true);
+    connect(statusTimer, &QTimer::timeout, m_externalActionsStatus, &QLabel::hide);
+    makeChild(m_externalActionsStatus);
+    m_externalActionsStatus->move(m_externalActionsButton->pos() +
+      QPoint(0, m_externalActionsButton->height() + 4));
+    m_externalActionsStatus->hide();
+}
+
+void CaptureWidget::showExternalActionMessage(const QString& message)
+{
+    m_externalActionsStatus->setText(message);
+    m_externalActionsStatus->adjustSize();
+    m_externalActionsStatus->show();
+    m_externalActionsStatus->raise();
+    m_externalActionsStatus->findChild<QTimer*>()->start(5000);
+}
+
+void CaptureWidget::runExternalAction(const ExternalAction& action)
+{
+    if (m_externalActionRunner->running()) {
+        return;
+    }
+    if (m_context.selection.isEmpty()) {
+        showExternalActionMessage(tr("Select an area before running an external action"));
+        return;
+    }
+    commitCurrentTool();
+    drawToolsData(false);
+    QByteArray png;
+    QBuffer buffer(&png);
+    buffer.open(QIODevice::WriteOnly);
+    if (!pixmap().save(&buffer, "PNG") ||
+        !m_externalActionRunner->start(action, png)) {
+        showExternalActionMessage(tr("Could not encode PNG (maximum 64 MiB)"));
+    } else {
+        showExternalActionMessage(tr("Running external action: %1").arg(action.name));
     }
 }
 
