+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "externalactions.h"
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+
+QVector<ExternalAction> loadExternalActions()
+{
+    QString config = qEnvironmentVariable("XDG_CONFIG_HOME");
+    if (config.isEmpty() || !QDir::isAbsolutePath(config)) {
+        config = QDir::homePath() + "/.config";
+    }
+    QDir dir(config + "/flameshot/actions.d");
+    QVector<ExternalAction> result;
+    int count = 0;
+    for (const QString& file : dir.entryList({ "*.json" }, QDir::Files, QDir::Name)) {
+        if (++count > 128) {
+            break;
+        }
+        QFile input(dir.filePath(file));
+        if (!input.open(QIODevice::ReadOnly) || input.size() > 65536) {
+            qWarning() << "Cannot read external action:" << input.fileName();
+            continue;
+        }
+        const auto doc = QJsonDocument::fromJson(input.read(65537));
+        const auto obj = doc.object();
+        ExternalAction action;
+        action.name = obj.value("name").toString();
+        action.program = obj.value("program").toString();
+        action.shortcut = obj.value("shortcut").toString();
+        action.icon = obj.value("icon").toString();
+        const auto timeout = obj.value("timeout");
+        action.timeout = timeout.isUndefined() ? 60000 : timeout.toInt(-1);
+        bool valid = doc.isObject() && !action.name.trimmed().isEmpty() &&
+                     action.name.size() <= 200 && action.program.size() <= 4096 &&
+                     QDir::isAbsolutePath(action.program) &&
+                     !action.program.contains(QChar::Null) &&
+                     action.shortcut.size() <= 128 && action.icon.size() <= 256 &&
+                     (obj.value("shortcut").isUndefined() || obj.value("shortcut").isString()) &&
+                     (obj.value("icon").isUndefined() || obj.value("icon").isString()) &&
+                     action.timeout >= 1 && action.timeout <= 300000 &&
+                     (timeout.isUndefined() || (timeout.isDouble() && timeout.toDouble() == action.timeout)) &&
+                     obj.value("arguments").isArray();
+        const auto args = obj.value("arguments").toArray();
+        valid = valid && args.size() <= 128;
+        for (const auto& arg : args) {
+            valid = valid && arg.isString() && arg.toString().size() <= 4096 &&
+                    !arg.toString().contains(QChar::Null);
+            action.arguments.append(arg.toString());
+        }
+        if (valid) {
+            result.append(action);
+        } else {
+            qWarning() << "Invalid external action:" << input.fileName();
+        }
+    }
+    return result;
+}
+
+ExternalActionRunner::ExternalActionRunner(QObject* parent)
+  : QObject(parent)
+{
+    m_timer.setSingleShot(true);
+    // Never buffer script output in Qt or interpret it as UI markup.
+    m_process.setStandardOutputFile(QProcess::nullDevice());
+    m_process.setStandardErrorFile(QProcess::nullDevice());
+    connect(&m_timer, &QTimer::timeout, this, [this]() {
+        m_failure = tr("External action timed out");
+        m_process.kill();
+    });
+    connect(&m_process, &QProcess::started, this, [this]() {
+        m_process.write(m_png);
+        m_png.clear();
+        m_process.closeWriteChannel();
+    });
+    connect(&m_process, &QProcess::errorOccurred, this, [this](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart) {
+            finish(false, tr("Could not start external action"));
+        } else if (error == QProcess::WriteError) {
+            m_failure = tr("Could not send PNG to external action");
+            m_process.kill();
+        }
+    });
+    connect(&m_process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this, [this](int code, QProcess::ExitStatus status) {
+        const bool success = m_failure.isEmpty() && status == QProcess::NormalExit && code == 0;
+        finish(success, success ? QString() : (m_failure.isEmpty()
+            ? tr("External action failed (exit %1)").arg(code) : m_failure));
+    });
+}
+
+ExternalActionRunner::~ExternalActionRunner()
+{
+    m_timer.stop();
+    m_process.disconnect(this);
+    if (m_process.state() != QProcess::NotRunning) {
+        m_process.kill();
+        m_process.waitForFinished(1000);
+    }
+}
+
+bool ExternalActionRunner::start(const ExternalAction& action, const QByteArray& png)
+{
+    if (m_running || png.isEmpty() || png.size() > 64 * 1024 * 1024 ||
+        action.timeout < 1 || action.timeout > 300000) {
+        return false;
+    }
+    m_running = true;
+    m_failure.clear();
+    m_png = png;
+    m_timer.start(action.timeout);
+    m_process.start(action.program, action.arguments, QIODevice::WriteOnly);
+    return true;
+}
+
+void ExternalActionRunner::cancel()
+{
+    if (m_running) {
+        m_failure = tr("External action cancelled");
+        m_process.kill();
+    }
+}
+
+void ExternalActionRunner::finish(bool success, const QString& message)
+{
+    if (!m_running) {
+        return;
+    }
+    m_running = false;
+    m_timer.stop();
+    m_png.clear();
+    emit finished(success, message);
+}
