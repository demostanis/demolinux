#!/usr/bin/env python3
"""Fingerprint build inputs, including recipe patches and file modes."""

import hashlib
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
BASE = ["archive_date", "build_packages", "pacman.conf", "bin/mkarchiso",
        "bin/build-inputs", ".github/setup-pacman.sh"]
PACKAGES = BASE + ["available_packages", "deps.lock", "packages/tobuild",
                   "nvim_packages", "zsh_plugins"]
ROOTFS = PACKAGES + ["airootfs", "profiledef.sh"]


def fingerprint(paths):
    result = subprocess.run(
        ["git", "-c", f"safe.directory={ROOT}", "ls-files", "-z", "--cached",
         "--others", "--exclude-standard", "--", *paths],
        cwd=ROOT, check=True, stdout=subprocess.PIPE,
    )
    digest = hashlib.sha256()
    for name in sorted(set(result.stdout.split(b"\0")) - {b""}):
        path = ROOT / os.fsdecode(name)
        digest.update(name + b"\0")
        if path.is_symlink():
            payload = os.fsencode(os.readlink(path))
            mode = b"symlink"
        elif path.is_file():
            payload = path.read_bytes()
            mode = str(path.stat().st_mode & 0o777).encode()
        else:
            payload, mode = b"", b"missing"
        digest.update(mode + b"\0" + hashlib.sha256(payload).digest())
    return digest.hexdigest()


if __name__ == "__main__":
    groups = {"base": BASE, "packages": PACKAGES, "rootfs": ROOTFS}
    if len(sys.argv) < 2:
        sys.exit("usage: build-inputs {base|packages|rootfs|paths PATH...}")
    paths = sys.argv[2:] if sys.argv[1] == "paths" else groups[sys.argv[1]]
    print(fingerprint(paths))
