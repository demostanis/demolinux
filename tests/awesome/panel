#!/bin/bash

open_panel() {
	if ! awesome-client 'return screen.primary.mypanel.visible' | grep -q 'boolean true'; then
		modkeypress p
	fi
	expectawesome 'return screen.primary.mypanel.visible'
}

open_panel
xdotool key w
expectwin iwgtk
quitwin

open_panel
ip() {
	curl -4 --fail --silent --show-error --connect-timeout 5 --max-time 10 icanhazip.com
}

orig=$(ip) || {
	echo "could not determine the public IP before connecting RiseupVPN" >&2
	exit 1
}
sudo systemctl start riseup-init.service
xdotool key v

tries=12
success=
for ((i = 1; i <= tries; i++)); do
	sleep 3
	new=$(ip) || continue
	if [ "$orig" != "$new" ]; then
		success=y
		break
	fi
done
if [ -z "$success" ]; then
	echo RiseupVPN is broken, can\'t connect >&2
	exit 1
fi

open_panel
xdotool key v

success=
for ((i = 1; i <= tries; i++)); do
	sleep 3
	new=$(ip) || continue
	if [ "$new" = "$orig" ]; then
		success=y
		break
	fi
done
if [ -z "$success" ]; then
	echo RiseupVPN is broken, can\'t disconnect >&2
	exit 1
fi

wait_for_recorder_status() {
	local expected=$1
	local actual
	for _ in {1..100}; do
		actual=$(screenrecord status)
		[ "$actual" = "$expected" ] && return
		sleep 0.1
	done
	echo "screen recorder did not reach '$expected' state (got '$actual')" >&2
	return 1
}

recording=
cleanup_recording_test() {
	local result=$?
	if (( result != 0 )) && [[ -f /tmp/record-playback.log ]]; then
		cat /tmp/record-playback.log >&2
	fi
	if (( result != 0 )); then
		xrefresh
		import -window root /data/screenshot.png || :
	fi
	screenrecord stop >/dev/null 2>&1 || :
	[ -n "$recording" ] && rm -f "$recording"
	rm -f record.mp4
}
trap cleanup_recording_test EXIT

screenrecord stop
wait_for_recorder_status "Not recording"

open_panel
xdotool key r
wait_for_recorder_status "Recording..."
sleep 2
xdotool key r
wait_for_recorder_status "Not recording"
xdotool key Escape

recording=$(screenrecord output)
[ -n "$recording" ]
[ -s "$recording" ]
ffprobe -v error -select_streams v:0 \
	-show_entries stream=codec_name,width,height \
	-of default=noprint_wrappers=1 "$recording"
# Keep playback alive beyond the bounded wait for a software-rendered window.
ffmpeg -v error -stream_loop -1 -i "$recording" -t 120 -c copy record.mp4
rm -f "$recording"
recording=
xdg-open record.mp4 >/tmp/record-playback.log 2>&1 &
expectwin 'record.mp4 - mpv' 30
activatewin 'record.mp4 - mpv'
quitwin

open_panel
sudo systemctl start pacman-init
xdotool key c
sleep 1
xdotool click 1
expectwin 'Color picker'
quitwin
