#!/bin/bash

sorted_windows() {
	xwininfo -root -tree | \
		grep urxvt | awk -F'["+]' '
		{gsub(/(^ +)|( +$)/,"",$2);print $10 " " $2}
		' | sort -n | cut -d' ' -f2-
}

for win in {1..3}; do
	urxvt -title "layout window $win" -e sleep infinity &
	expectwin "layout window $win"
	expectfocus "layout window $win"
	expectviewport
done

modkeypress h
expectfocus "layout window 2"
expectviewport
modkeypress h
expectfocus "layout window 1"
expectviewport
modkeypress equal
expectawesome 'return client.focus.width < client.focus.screen.geometry.width / 3 + 5'

for win in 2 3 1; do
	modkeypress Tab
	expectfocus "layout window $win"
done

assert_windows() {
	expected=$1
	for _ in {1..100}; do
		actual="$(sorted_windows)"
		[ "$actual" = "$expected" ] && return
		sleep 0.1
	done
	echo expected window list to be $expected, but got $actual
	exit 1
}

assert_windows 'layout window 1
layout window 2
layout window 3'

modkeypress L
assert_windows 'layout window 2
layout window 1
layout window 3'

modkeypress H
assert_windows 'layout window 1
layout window 2
layout window 3'

modkeypress l
modkeypress l
expectfocus "layout window 3"

modkeypress h
expectfocus "layout window 2"

# Dispatch a burst before Awesome can apply a pending layout arrangement.
awesome-client 'layout.move_left_window(); layout.move_right_window(); layout.move_right_window()'
expectfocus "layout window 3"
expectviewport
awesome-client 'layout.move_left_window(); layout.move_left_window()'
expectfocus "layout window 1"
expectviewport

# An old X11 FocusIn must not replace the last requested navigation target.
awesome-client 'local old = client.focus; layout.move_right_window(); client.focus = old; layout.move_right_window()'
expectfocus "layout window 3"
expectviewport
awesome-client 'local old = client.focus; layout.move_left_window(); client.focus = old; layout.move_left_window()'
expectfocus "layout window 1"
expectviewport

# Focusing a neighbor without scrolling must not change the navigation anchor.
awesome-client 'for _, c in ipairs(client.get()) do if c.name == "layout window 2" then c:activate { raise = false }; break end end'
expectfocus "layout window 2"
expectawesome 'return layout.leftmost_window().name == "layout window 1"'
modkeypress l
expectfocus "layout window 2"
expectviewport
modkeypress h
expectfocus "layout window 1"
expectviewport

# The same rule applies when navigating left from a differently focused window.
modkeypress l
expectfocus "layout window 2"
expectviewport
awesome-client 'for _, c in ipairs(client.get()) do if c.name == "layout window 3" then c:activate { raise = false }; break end end'
expectfocus "layout window 3"
expectawesome 'return layout.leftmost_window().name == "layout window 2"'
modkeypress h
expectfocus "layout window 1"
expectviewport

# Focus-only activation between queued moves must not discard the pending viewport.
awesome-client 'layout.move_right_window(); for _, c in ipairs(client.get()) do if c.name == "layout window 1" then c:activate { raise = false }; break end end; layout.move_right_window()'
expectfocus "layout window 3"
expectviewport
awesome-client 'layout.move_left_window(); layout.move_left_window()'
expectfocus "layout window 1"
expectviewport

quitwin
quitwin
quitwin
