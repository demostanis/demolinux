#!/bin/bash

# tests/run sources this file in zsh; execute the suite in Bash either way.
sudo bash <<'BASH'
set -Eeuo pipefail
systemd-detect-virt --vm --quiet || { echo 'Run in a disposable VM' >&2; exit 1; }

upper=/run/archiso/persistfs/upperdir
index=$upper/index
root=
packages=()
extra_paths=()
export TERM=xterm

pfs() {
	timeout 30 persistfs "$@" > "$root/stdout" 2> "$root/stderr"
}

expect_failure() {
	if "$@"; then
		printf 'Expected failure: %s\n' "$*" >&2
		return 1
	fi
}

read_index() {
	pfs list --all --null
	mapfile -d '' -t entries < "$root/stdout"
}

index_count() {
	local entry count=0
	for entry in "${entries[@]}"; do
		[[ "$entry" != "$1" ]] || count=$((count + 1))
	done
	[[ "$count" = "$2" ]]
}

cleanup_case() {
	[[ -n "$root" ]] || return 0
	if (( ${#packages[@]} )); then
		pacman -Rdd --noconfirm "${packages[@]}" >/dev/null 2>&1 || :
	fi
	if [[ "$index_existed" = 1 ]]; then
		cp -- "$root/index.before" "$index"
	else
		rm -f -- "$index"
	fi
	if (( ${#extra_paths[@]} )); then
		rm -rf -- "${extra_paths[@]}"
	fi
	rm -rf -- "$saved" "$root"
	root=
}

fail() {
	printf 'FAIL: %s, line %s: %s\n' "${test:-setup}" "$1" "$2" >&2
	if [[ -n "$root" ]]; then
		cat "$root/stdout" "$root/stderr" "$root"/*.log >&2 2>/dev/null || :
	fi
}

trap 'fail "$LINENO" "$BASH_COMMAND"' ERR
trap cleanup_case EXIT

test_basic_file() {
	printf 'payload\n' > "$root/file"
	pfs add "$root/file"
	cmp "$root/file" "$saved/file"
	pfs add "$root/file"
	cmp "$root/file" "$saved/file"
	pfs remove "$root/file"
	[[ ! -e "$saved/file" && -f "$root/file" ]]
	expect_failure pfs add "$root/missing" "$root/file"
	[[ ! -e "$saved/file" && ! -e "$saved/missing" ]]
}

test_basic_directory() {
	mkdir -p "$root/a/b/c"
	pfs add "$root/a"
	[[ -d "$saved/a/b/c" ]]
	pfs remove "$root/a/b/c"
	[[ ! -e "$saved/a" ]]
	[[ -d "$root/a/b/c" ]]
}

test_basic_symlink() {
	mkdir "$root/target"
	ln -s target "$root/link"
	pfs add "$root/link"
	[[ -L "$saved/link" && $(readlink "$saved/link") = target ]]
	pfs remove "$root/link"
	[[ ! -L "$saved/link" && -L "$root/link" ]]
}

test_package_install() {
	systemctl start pacman-init
	# Ignore yes's SIGPIPE, but retain the exit status of pfs.
	set +o pipefail
	yes | pfs ipkg wildcard
	set -o pipefail
	[[ -x "$upper/usr/bin/wildcard" ]]
	[[ $(stat -c '%a:%u:%g' /usr/bin/wildcard) = $(stat -c '%a:%u:%g' "$upper/usr/bin/wildcard") ]]
}

test_remove_cannot_escape_upperdir() {
	local victim="${upper%/*}/${root##*/}"
	extra_paths+=( "$victim" )
	printf 'outside\n' > "$victim"
	expect_failure pfs remove "/../${victim##*/}"
	[[ $(< "$victim") = outside ]]
}

test_symlink_ancestor_cannot_delete_source() {
	local link="$upper/${root##*/}"
	extra_paths+=( "$link" )
	printf 'payload\n' > "$root/victim"
	ln -s "$root" "$link"
	expect_failure pfs remove "/${link##*/}/victim"
	[[ $(< "$root/victim") = payload ]]
}

test_root_is_reserved() {
	expect_failure pfs remove /
	expect_failure pfs add /
}

test_failed_copy_returns_failure_without_indexing() {
	touch "$root/cannot-copy"
	expect_failure timeout 30 unshare --mount bash -ec '
		mount --make-rprivate /
		mount --bind "$1" "$1"
		mount -o remount,bind,ro "$1"
		exec persistfs add "$2"
	' bash "$upper" "$root/cannot-copy" > "$root/stdout" 2> "$root/stderr"
	grep -Fq rsync "$root/stderr"
	[[ ! -e "$saved/cannot-copy" ]]
	if [[ -f "$index" ]]; then
		! grep -aFq -- "$root/cannot-copy" "$index"
	fi
}

test_concurrent_index_updates() {
	local i pid
	local -a pids=() paths=()
	touch "$root/same-file"
	for i in {1..16}; do
		timeout 30 persistfs add "$root/same-file" > "$root/add-$i.log" 2>&1 &
		pids+=( "$!" )
	done
	for pid in "${pids[@]}"; do wait "$pid"; done
	pfs list --all
	[[ $(grep -Fxc -- "$root/same-file" "$root/stdout") = 1 ]]
	for i in {01..16}; do
		touch "$root/file-$i"
		paths+=( "$root/file-$i" )
	done
	pfs add "${paths[@]}"
	pids=()
	for i in "${!paths[@]}"; do
		timeout 30 persistfs remove "${paths[$i]}" > "$root/remove-$i.log" 2>&1 &
		pids+=( "$!" )
	done
	for pid in "${pids[@]}"; do wait "$pid"; done
	pfs list --all
	for i in "${paths[@]}"; do
		! grep -Fxq -- "$i" "$root/stdout"
	done
}

test_metadata_and_hardlinks_survive() {
	printf 'payload\n' > "$root/metadata"
	ln "$root/metadata" "$root/hardlink"
	setfattr -n user.persistfs-test -v keep "$root/metadata"
	setfacl -m u:demostanis:r-- "$root/metadata"
	setcap cap_net_bind_service=ep "$root/metadata"
	pfs add "$root/metadata" "$root/hardlink"
	getfacl -cp "$root/metadata" > "$root/source-acl"
	getfacl -cp "$saved/metadata" > "$root/saved-acl"
	cmp "$root/source-acl" "$root/saved-acl"
	local attr
	for attr in user.persistfs-test security.capability; do
		getfattr --absolute-names --only-values -n "$attr" "$root/metadata" > "$root/source-attr"
		getfattr --absolute-names --only-values -n "$attr" "$saved/metadata" > "$root/saved-attr"
		cmp "$root/source-attr" "$root/saved-attr"
	done
	[[ "$saved/metadata" -ef "$saved/hardlink" ]]
}

test_index_matches_whole_paths() {
	touch "$root/prefix" "$root/prefix-long" "$root/square[1]"
	pfs add "$root/prefix-long" "$root/prefix" "$root/square[1]" "$root/square[1]"
	read_index
	index_count "$root/prefix" 1
	index_count "$root/square[1]" 1
	pfs remove "$root/prefix"
	read_index
	index_count "$root/prefix" 0
	index_count "$root/prefix-long" 1
}

test_unusual_filenames_roundtrip() {
	local name
	local -a paths=()
	for name in 'space name' "quote'name" 'back\slash' $'line\nbreak' $'trailing\n' $'parent\n/child\n'; do
		if [[ "$name" = */* ]]; then
			mkdir -p -- "$root/${name%/*}"
		fi
		touch -- "$root/$name"
		paths+=( "$root/$name" )
	done
	pfs add "${paths[@]}"
	pfs list --null
	mapfile -d '' -t entries < "$root/stdout"
	for name in "${paths[@]}"; do
		[[ -f "$upper$name" ]]
		index_count "$name" 1
	done
	pfs remove "${paths[@]}"
	read_index
	for name in "${paths[@]}"; do index_count "$name" 0; done
}

test_normalized_remove_updates_index() {
	touch "$root/relative-dot"
	pfs add "$root/relative-dot"
	pfs remove "$root/./relative-dot"
	read_index
	index_count "$root/relative-dot" 0
}

test_index_normalizes_directory_spellings() {
	mkdir "$root/dir"
	pfs add "$root/dir" "$root/dir/." "$root/dir/"
	read_index
	index_count "$root/dir" 1
	index_count "$root/dir/." 0
	index_count "$root/dir/" 0
}

test_legacy_index_migration() {
	touch "$root/legacy"
	printf '%s\n' "$root/legacy" "$root/./legacy" > "$index"
	printf '%s\0' "$root/legacy" > "$root/expected-index"
	pfs list --all --null
	cmp "$root/expected-index" "$root/stdout"
	pfs add "$root/legacy"
	cmp "$root/expected-index" "$index"
}

test_dangling_symlink_roundtrip() {
	ln -s missing-target "$root/dangling"
	pfs add "$root/dangling"
	[[ -L "$saved/dangling" && $(readlink "$saved/dangling") = missing-target ]]
	pfs remove "$root/dangling"
	[[ ! -L "$saved/dangling" && -L "$root/dangling" ]]
}

test_dataize_rejects_persisted_directory() {
	local path="$root/dataized" data="/data/${root//\//_}_dataized"
	extra_paths+=( "$data" )
	mkdir -p "$path/subdir"
	printf 'payload\n' > "$path/subdir/child"
	pfs add "$path" "$path/subdir/child"
	cp "$index" "$root/expected-index"
	expect_failure dataize "$path" > "$root/stdout" 2> "$root/stderr"
	grep -Fq 'already in persistfs' "$root/stderr"
	[[ ! -L "$path" && ! -L "$upper$path" && ! -e "$data" ]]
	[[ $(< "$path/subdir/child") = payload ]]
	cmp "$path/subdir/child" "$upper$path/subdir/child"
	cmp "$index" "$root/expected-index"
	pfs remove "$path"
	dataize "$path" > "$root/stdout" 2> "$root/stderr"
	[[ -L "$upper$path" ]]
}

test_pfs_rejects_directory_symlink_conflicts_without_changes() {
	mkdir -p "$root/tree/.nested"
	printf 'payload\n' > "$root/tree/.nested/child"
	printf 'saved\n' > "$root/other"
	pfs add "$root/tree" "$root/other"
	cp "$index" "$root/expected-index"
	rm -rf "$root/tree/.nested"
	ln -s /data "$root/tree/.nested"
	printf 'unsaved\n' > "$root/other"
	local path
	for path in "$root/tree/.nested" "$root/tree"; do
		expect_failure pfs add "$path"
		grep -Fq 'Type conflict' "$root/stderr"
		[[ $(< "$saved/tree/.nested/child") = payload ]]
		cmp "$index" "$root/expected-index"
	done
	expect_failure pfs add "$root/other" "$root/tree"
	grep -Fq 'Type conflict' "$root/stderr"
	[[ $(< "$saved/other") = saved ]]
	cmp "$index" "$root/expected-index"
}

test_pfs_rejects_directory_over_saved_symlink() {
	ln -s /data "$root/link"
	pfs add "$root/link"
	cp "$index" "$root/expected-index"
	rm "$root/link"
	mkdir "$root/link"
	expect_failure pfs add "$root/link"
	grep -Fq 'Type conflict' "$root/stderr"
	[[ -L "$saved/link" ]]
	cmp "$index" "$root/expected-index"
}

test_dataized_children_are_not_copied_back() {
	local data="/data/${root//\//_}_dataized"
	extra_paths+=( "$data" )
	mkdir "$root/dataized"
	printf 'payload\n' > "$root/dataized/child"
	dataize "$root/dataized" > "$root/stdout" 2> "$root/stderr"
	expect_failure pfs add "$root/dataized/child"
	expect_failure pfs add "$data/child"
	expect_failure pfs remove "$root/dataized/child"
	[[ -L "$saved/dataized" && $(< "$root/dataized/child") = payload ]]
}

test_live_dataized_ancestor_without_saved_link() {
	local data="/data/${root##*/}" previous_data
	extra_paths+=( "$data" )
	previous_data=$(stat -c '%F' "$upper/data" 2>/dev/null || :)
	mkdir "$data"
	printf 'already persistent\n' > "$data/child"
	ln -s "$data" "$root/link"
	expect_failure pfs add "$root/link/child"
	expect_failure pfs add "$data/child"
	[[ $(stat -c '%F' "$upper/data" 2>/dev/null || :) = "$previous_data" ]]
	pfs add "$root/link"
	[[ -L "$saved/link" ]]
}

test_directory_refresh_removes_only_stale_children() {
	mkdir "$root/tree"
	touch "$root/tree/obsolete" "$root/tree/keep" "$root/unrelated"
	pfs add "$root/tree" "$root/tree/obsolete" "$root/unrelated"
	rm "$root/tree/obsolete"
	pfs add "$root/tree"
	[[ ! -e "$saved/tree/obsolete" && -f "$saved/tree/keep" && -f "$saved/unrelated" ]]
	read_index
	index_count "$root/tree/obsolete" 0
	pfs add "$root/tree/keep"
	[[ -f "$saved/unrelated" ]]
}

test_remove_prunes_empty_parents_and_their_index() {
	mkdir -p "$root/empty/a/b"
	touch "$root/empty/a/b/child" "$root/sibling"
	pfs add "$root/empty/a" "$root/empty/a/b/child" "$root/sibling"
	pfs remove "$root/empty/a/b/child"
	[[ ! -e "$saved/empty" && -f "$saved/sibling" && -f "$root/empty/a/b/child" ]]
	read_index
	index_count "$root/empty/a" 0
	index_count "$root/empty/a/b/child" 0
	pfs remove "$root/sibling"
	[[ ! -e "$saved" && -d "$upper" ]]
}

test_remove_stops_at_nonempty_parent() {
	mkdir "$root/tree"
	touch "$root/tree/child" "$root/tree/.keep"
	pfs add "$root/tree"
	pfs remove "$root/tree/child"
	[[ -f "$saved/tree/.keep" ]]
	read_index
	index_count "$root/tree" 1
}

test_package_versions_providers_and_recursive_dependencies() {
	local stem=${root##*/} role name build archive
	local main=$stem-main provider=$stem-provider sibling=$stem-sibling leaf=$stem-leaf virtual=$stem-virtual
	local -a archives=()
	extra_paths+=( "/opt/$stem" "$upper/opt/$stem" )
	for role in main provider sibling leaf; do
		name=$stem-$role
		packages+=( "$name" )
		extra_paths+=( "$upper/var/lib/pacman/local/$name-r1-1" )
		build="$root/build-$role"
		archive="$root/$name.pkg.tar.gz"
		mkdir -p "$build/opt/$stem"
		printf 'payload' > "$build/opt/$stem/$name with space"
		{
			printf 'pkgname = %s\npkgver = r1-1\npkgdesc = persistfs test\narch = any\nsize = 7\n' "$name"
			case "$role" in
				main) printf 'depend = %s>=2\ndepend = %s>=r1\n' "$virtual" "$sibling" ;;
				provider) printf 'provides = %s=2\n' "$virtual" ;;
				sibling) printf 'depend = %s\n' "$leaf" ;;
				leaf) printf 'depend = %s\n' "$main" ;;
			esac
		} > "$build/.PKGINFO"
		tar -czf "$archive" -C "$build" .PKGINFO opt
		archives+=( "$archive" )
	done
	timeout 60 pacman -U --noconfirm "${archives[@]}" > "$root/stdout" 2> "$root/stderr"
	pfs pkg "$main>=r1"
	for name in "${packages[@]}"; do
		[[ -f "$upper/opt/$stem/$name with space" ]]
		[[ -f "$upper/var/lib/pacman/local/$name-r1-1/desc" ]]
	done
	pfs pkg "$virtual>=2"
	expect_failure pfs pkg "$virtual>2"
}

for test in \
	test_basic_file \
	test_basic_directory \
	test_basic_symlink \
	test_package_install \
	test_remove_cannot_escape_upperdir \
	test_symlink_ancestor_cannot_delete_source \
	test_root_is_reserved \
	test_failed_copy_returns_failure_without_indexing \
	test_concurrent_index_updates \
	test_metadata_and_hardlinks_survive \
	test_index_matches_whole_paths \
	test_unusual_filenames_roundtrip \
	test_normalized_remove_updates_index \
	test_index_normalizes_directory_spellings \
	test_legacy_index_migration \
	test_dangling_symlink_roundtrip \
	test_dataize_rejects_persisted_directory \
	test_pfs_rejects_directory_symlink_conflicts_without_changes \
	test_pfs_rejects_directory_over_saved_symlink \
	test_dataized_children_are_not_copied_back \
	test_live_dataized_ancestor_without_saved_link \
	test_directory_refresh_removes_only_stale_children \
	test_remove_prunes_empty_parents_and_their_index \
	test_remove_stops_at_nonempty_parent \
	test_package_versions_providers_and_recursive_dependencies
do
	root=$(mktemp -d /tmp/pfs-test.XXXXXXXX)
	saved=$upper$root
	packages=()
	extra_paths=()
	index_existed=0
	if [[ -f "$index" ]]; then
		cp -- "$index" "$root/index.before"
		index_existed=1
	fi
	"$test"
	printf 'PASS: %s\n' "$test"
	cleanup_case
done
BASH
