pkgname=firefox-devtools-mcp
pkgver=0.7.4
pkgrel=7
pkgdesc="Model Context Protocol (MCP) server for Firefox DevTools automation"
arch=('any')
url="https://github.com/freema/firefox-devtools-mcp"
license=('MIT')
depends=('nodejs' 'firefox' 'geckodriver')
makedepends=('npm')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
        "do-not-copy-lock-file-when-launching-selenium.patch"
        "enable-evaluate-script.patch"
        "reopen-firefox-on-disconnect.patch"
        "update-reconnect-tests.patch"
        "serialize-firefox-initialization.patch"
        "capture-firefox-in-opencode-sidewindow.patch"
        "use-bidi-responsive-viewport.patch")
sha256sums=('50507454043ee1c214aea7adb084915dbbd6d675c93c03f53adccc2531f52fc7'
            '1f9591626c7d0fbce296f7b58693c41c2f960e0dc8dbdd8ded008b67520600a1'
            'ce84db60c3da781f958ae0d446d4986a401384b79de83311875c7ab144a8bc95'
            '0c2e584b0d2e91db84ac077b55d5b4a14eaaea4dae294ef05952d7c3695f797d'
            '071e4377cb66fad695b33fa4c5d436b23e772d2747dc92edded0b5be91bfc606'
            'd5ef6e033f41a30dc67d897c9ff9608663b44907c81c5efe06287b7326487425'
             'cb4db1f2b79bc2f7c5f1b0c809ac461630560df5394beda7ec99c2e4ee13640c'
             '9e781b9a1cbe104b18152c98073bdf0232a09204fc454b220670b5d5201f46b7')

prepare() {
  cd "$pkgname-$pkgver"
  npm install
  patch -p2 -i "$srcdir/do-not-copy-lock-file-when-launching-selenium.patch"
  patch -p2 -i "$srcdir/enable-evaluate-script.patch"
  patch -p2 -i "$srcdir/reopen-firefox-on-disconnect.patch"
  patch -p2 -i "$srcdir/update-reconnect-tests.patch"
  patch -p2 -i "$srcdir/serialize-firefox-initialization.patch"
  patch -p2 -i "$srcdir/capture-firefox-in-opencode-sidewindow.patch"
  patch -p2 -i "$srcdir/use-bidi-responsive-viewport.patch"
}

build() {
  cd "$pkgname-$pkgver"
  npm run build
}

package() {
  cd "$pkgname-$pkgver"
  
  local _node_dir="/usr/lib/node_modules/$pkgname"
  
  npm prune --production
  
  install -d "$pkgdir$_node_dir"
  cp -ra dist package.json node_modules "$pkgdir$_node_dir/"
  
  install -d "$pkgdir/usr/bin"
  ln -s "$_node_dir/dist/index.js" "$pkgdir/usr/bin/$pkgname"
  
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
