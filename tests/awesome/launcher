#!/bin/bash

modkeypress space
expectawesome 'local launcher = screen.primary.app_launcher
    return launcher and launcher.visible'

# it used to break that easily...
for i in {0..20}; do
	xdotool key Right
done
for i in {0..20}; do
	xdotool key Left
done
xdotool type nemo
expectawesome 'local launcher = screen.primary.app_launcher
    if not launcher or not launcher.visible then return false end
    local apps = {}
    for _, child in ipairs(launcher.widget:get_all_children()) do
        if type(child.spawn) == "function" then table.insert(apps, child) end
    end
    if #apps ~= 1 or not apps[1].selected then return false end
    local names = apps[1]:get_children_by_id("name")
    return #names == 1 and names[1].text == "Files"'
xdotool key Enter

# nemo
expectwin Home

quitwin
