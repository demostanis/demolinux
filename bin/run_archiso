#!/usr/bin/env bash
#
# Copyright (C) 2020 David Runge <dvzrv@archlinux.org>
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# A simple script to run a demolinux disk image using qemu. The image can be booted
# using BIOS or UEFI.
#
# Requirements:
# - qemu (with libslirp user networking)
# - edk2-ovmf (when UEFI booting)


set -eu

print_help() {
    local usagetext
    IFS='' read -r -d '' usagetext <<EOF || true
Usage:
    run_archiso [options]

Options:
    -a              set accessibility support using brltty
    -b              set boot type to 'BIOS' (default)
    -d              boot from hard disk (default)
    -h              print help
    -i [image]      image to boot into
    -H              run headless (-nographic)
    -T [size]       truncate image to specific size
    -S              use a temporary qcow2 overlay (leave the image untouched)
    -s              use Secure Boot (only relevant when using UEFI)
    -u              set boot type to 'UEFI'
    -v              use VNC display (instead of default SDL)
    -c [image]      attach an additional optical disc image (e.g. for cloud-init)

Example:
    Run an image using UEFI:
    $ run_archiso -u -i out/demolinux-2026.09.10-x86_64.img
EOF
    printf '%s' "${usagetext}"
}

cleanup_working_dir() {
    if [[ -n "${qemu_pid:-}" ]]; then
        kill "${qemu_pid}" 2>/dev/null || true
        wait "${qemu_pid}" 2>/dev/null || true
    fi
    if [[ -d "${working_dir}" ]]; then
        rm -rf -- "${working_dir}"
    fi
}

copy_ovmf_vars() {
    local ovmf_vars
    if [[ -f /usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd ]]; then
        ovmf_vars=/usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd
        ovmf_code=/usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd
        [[ "$secure_boot" != on ]] || ovmf_code=/usr/share/edk2-ovmf/x64/OVMF_CODE.secboot.4m.fd
    else
        ovmf_vars=/usr/share/OVMF/OVMF_VARS_4M.fd
        ovmf_code=/usr/share/OVMF/OVMF_CODE_4M.fd
        [[ "$secure_boot" != on ]] || ovmf_code=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
    fi
    if [[ ! -f "$ovmf_vars" || ! -f "$ovmf_code" ]]; then
        printf 'ERROR: %s\n' "OVMF firmware not found. Install edk2-ovmf (Arch) or ovmf (Ubuntu)."
        exit 1
    fi
    cp -- "$ovmf_vars" "${working_dir}/OVMF_VARS.fd"
}

check_image() {
    if [[ -z "$image" ]]; then
        printf 'ERROR: %s\n' "Image name can not be empty."
        exit 1
    fi
    if [[ ! -f "$image" ]]; then
        printf 'ERROR: %s\n' "Image file (${image}) does not exist."
        exit 1
    fi
}

truncate_image() {
    if [[ "$snapshot" == y ]]; then
        qemu-img create -q -f qcow2 -F raw -b "$(realpath -- "$image")" "${working_dir}/disk.qcow2"
        image="${working_dir}/disk.qcow2"
        image_format=qcow2
        if [[ -n "$truncatesize" ]]; then
            qemu-img resize -q "$image" "$truncatesize"
        fi
    elif [ -n "$truncatesize" ]; then
        truncate -s "$truncatesize" "$image"
    fi
}

run_image() {
    if [[ "$boot_type" == 'uefi' ]]; then
        local ovmf_code
        copy_ovmf_vars
        if [[ "${secure_boot}" == 'on' ]]; then
            printf '%s\n' 'Using Secure Boot'
        fi
        qemu_options+=(
            '-drive' "if=pflash,format=raw,unit=0,file=${ovmf_code},read-only=on"
            '-drive' "if=pflash,format=raw,unit=1,file=${working_dir}/OVMF_VARS.fd"
            '-global' "driver=cfi.pflash01,property=secure,value=${secure_boot}"
        )
    fi

    if [[ "${accessibility}" == 'on' ]]; then
        qemu_options+=(
            '-chardev' 'braille,id=brltty'
            '-device' 'usb-braille,id=usbbrl,chardev=brltty'
        )
    fi

    if [[ -n "${oddimage}" ]]; then
        qemu_options+=(
            '-device' 'scsi-cd,bus=scsi0.0,drive=cdrom1'
            '-drive' "id=cdrom1,if=none,format=raw,media=cdrom,read-only=on,file=${oddimage}"
        )
    fi

    if [ "$headless" = y ]; then
        display=none
        qemu_options+=( -monitor none )
    fi

    qemu-system-x86_64 \
        -boot "order=${boot_order},menu=on,reboot-timeout=5000" \
        -m "${DEMOLINUX_VM_MEMORY:-3072}" \
        -smp "${DEMOLINUX_VM_CPUS:-1}" \
        -k en-us \
        -name archiso,process=archiso_0 \
        -drive "format=${image_format},file=${image},if=none,id=rootdisk" \
        -device pcie-root-port,id=bootport,chassis=1 \
        -device virtio-blk-pci,drive=rootdisk,id=bootdisk,bus=bootport,bootindex=1 \
        -display "${display}" \
        -vga virtio \
        -device virtio-net-pci,romfile=,netdev=net0 \
        -object rng-random,id=rng0,filename=/dev/urandom \
        -device virtio-rng-pci,rng=rng0 \
        -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:${DEMOLINUX_SSH_PORT:-60022}-:22" \
        -qmp "tcp:127.0.0.1:${DEMOLINUX_QMP_PORT:-4444},server=on,wait=off" \
        -machine type=q35,smm=on,accel=kvm,usb=on \
        -cpu max -enable-kvm \
        -serial stdio \
        "${qemu_options[@]}" &
    qemu_pid=$!
    wait "$qemu_pid"
}

image=''
oddimage=''
accessibility=''
boot_type='bios'
boot_order=c
secure_boot='off'
headless='n'
display='gtk,show-cursor=on'
qemu_options=()
qemu_pid=''
snapshot=n
image_format=raw
working_dir="$(mktemp -dt run_archiso.XXXXXXXXXX)"
truncatesize=''
trap cleanup_working_dir EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if (( ${#@} > 0 )); then
    while getopts 'abc:dhHi:T:Ssuv' flag; do
        case "$flag" in
            a)
                accessibility='on'
                ;;
            b)
                boot_type='bios'
                ;;
            c)
                oddimage="$OPTARG"
                ;;
            d)
                boot_order=c
                ;;
            h)
                print_help
                exit 0
                ;;
            H)
                headless='y'
                ;;
            i)
                image="$OPTARG"
                ;;
            u)
                boot_type='uefi'
                ;;
            s)
                secure_boot='on'
                ;;
            T)
                truncatesize="$OPTARG"
                ;;
            S)
                snapshot=y
                ;;
            v)
                display='none'
                qemu_options+=(-vnc 'vnc=0.0.0.0:0,vnc=[::]:0')
                ;;
            *)
                printf '%s\n' "Error: Wrong option. Try 'run_archiso -h'."
                exit 1
                ;;
        esac
    done
else
    print_help
    exit 1
fi

check_image
truncate_image
run_image
