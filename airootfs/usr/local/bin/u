#!/bin/sh

term=${*:-ur stupid}
response=$(curl -fsSL --connect-timeout 10 --max-time 30 \
  --get --data-urlencode "term=$term" \
  https://api.urbandictionary.com/v0/define) || exit "$?"

printf '%s\n' "$response" | jq -er '
  .list[0].definition // error("No definition found")
  | gsub("\\[|\\]"; "")
  | gsub("\r\n?"; "\n")
'
