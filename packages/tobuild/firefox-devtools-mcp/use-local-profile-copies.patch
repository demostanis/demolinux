+import { constants } from 'node:fs';
+import { cp, mkdtemp, readdir, rm } from 'node:fs/promises';
+import { createServer } from 'node:net';
+import { tmpdir } from 'node:os';
+import { basename, join } from 'node:path';
+
+const lockFiles = new Set(['parent.lock', 'lock', '.parentlock']);
+
+export class TemporaryFirefoxProfile {
+  private constructor(readonly path: string) {}
+
+  static async create(template: string): Promise<TemporaryFirefoxProfile> {
+    // The hardened launcher binds rust_* profiles into its private /tmp.
+    const profile = new TemporaryFirefoxProfile(await mkdtemp(join(tmpdir(), 'rust_mcp-')));
+    try {
+      // Copy contents rather than the root so the private 0700 directory stays private.
+      for (const entry of await readdir(template)) {
+        if (!lockFiles.has(entry)) {
+          await cp(join(template, entry), join(profile.path, entry), {
+            recursive: true,
+            dereference: true,
+            mode: constants.COPYFILE_FICLONE,
+            filter: (source) => !lockFiles.has(basename(source)),
+          });
+        }
+      }
+      return profile;
+    } catch (error) {
+      await profile.remove();
+      throw error;
+    }
+  }
+
+  async remove(): Promise<void> {
+    await rm(this.path, { recursive: true, force: true });
+  }
+}
+
+export function findMarionettePort(): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const server = createServer();
+    server.once('error', reject);
+    server.listen(0, '127.0.0.1', () => {
+      const address = server.address();
+      if (!address || typeof address === 'string') {
+        server.close(() => reject(new Error('Unable to allocate a Marionette port')));
+        return;
+      }
+      server.close((error) => (error ? reject(error) : resolve(address.port)));
+    });
+  });
+}
