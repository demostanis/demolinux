aur() {
	setopt local_options no_monitor no_notify
	for pkg in $@; do
		git clone https://aur.archlinux.org/$pkg.git &
	done
	wait
}

nvimpkg() {
	setopt local_options no_monitor no_notify
	for pkg in $@; do
		url="$pkg"
		name="${pkg##*/}"
		mypath=~/.local/share/nvim/site/pack/$name/start/
		mkdir -p "$mypath"

		[[ "$pkg" != https://* ]] && \
			url=https://github.com/$pkg
		git clone "$url" "$mypath$name" &
	done
	wait
}

nvim() {
	if [ -n "$NVIM" ]; then
		if (( $# > 0 )); then
			command nvim --server "$NVIM" --remote "$@"
		fi
	else
		command nvim "$@"
	fi
}

terminal_tab_hex() {
	print -rn -- "$1" | od -An -v -tx1 | tr -d ' \n'
}
