# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=opencode
pkgver=3.0.4+demolinux
_pkgver=3.0.4-demolinux
pkgrel=1
pkgdesc='The open source coding agent'
arch=('x86_64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
depends=(
  'curl'
  'gcc-libs'
  'glibc'
  'icu'
  'opencode-voice>=3.0.4+demolinux-1'
  'ripgrep'
  'tar'
  'xdotool'
  'xorg-xprop'
)
makedepends=(
  'bun'
  'git'
)
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'xclip: clipboard support on X11'
)
options=(
  '!debug'
  '!strip'
)
_opentui_ver=0.1.79
source=(
  "https://github.com/demostanis/opencode/archive/refs/tags/$_pkgver.tar.gz"
)
sha256sums=('b3a75aa26dfd74c314100512715f0bc41200e38eb6b0f7ce9b2abc93a2eeb50d')

prepare() {
  cd "$srcdir/$pkgname-$_pkgver" || return

  sed -i "s/\"packageManager\": \"bun@[^\"]*\"/\"packageManager\": \"bun@$(bun --version)\"/" package.json

  bun install
}

build() {
  cd "$srcdir/$pkgname-$_pkgver/packages/opencode" || return
  OPENCODE_VERSION=$pkgver bun run ./script/build.ts --single --baseline
}

package() {
  cd "$srcdir/$pkgname-$_pkgver" || return
  case $CARCH in
  aarch64) dir=opencode-linux-arm64 ;;
  x86_64) dir=opencode-linux-x64-baseline ;;
  esac
  install -vDm755 -t "$pkgdir/usr/bin" "packages/opencode/dist/$dir/bin/opencode"

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  export OPENCODE_DISABLE_MODELS_FETCH=1
  SHELL=/bin/bash "$pkgdir/usr/bin/opencode" completion \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/opencode"
  SHELL=/bin/zsh "$pkgdir/usr/bin/opencode" completion \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_opencode"
}
