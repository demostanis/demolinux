#!/bin/bash

pfs_dir=/run/archiso/persistfs
airfs_dir=/run/archiso/airootfs
pacmandb_dir=/var/lib/pacman/local

if [ $(id -u) -ne 0 ]; then
	echo You need root >&2
	exit 1
fi

case $1 in
	add|remove|pkg|list|diff)
		exec 9>"$pfs_dir/.persistfs.lock" || exit 1
		flock -x 9 || exit 1
		;;
esac

absolute_path() {
	IFS= read -r -d '' REPLY < <(realpath -msz -- "$1")
}

safe_path() {
	local path="$1" parent
	if [[ "$path" = / || "$path" = /index || "$path" = /index.tmp ]]; then
		printf 'Refusing reserved persistfs path: %s\n' "$path" >&2
		return 1
	fi
	parent=${path%/*}
	while [[ -n "$parent" && "$parent" != / ]]; do
		if [[ -L "$pfs_dir/upperdir$parent" ]]; then
			printf 'Refusing symlink ancestor in persistfs: %s\n' "$parent" >&2
			return 1
		fi
		parent=${parent%/*}
	done
}

safe_source() {
	local parent data_dir resolved
	IFS= read -r -d '' parent < <(realpath -ez -- "${1%/*}/") || return 1
	IFS= read -r -d '' data_dir < <(realpath -mz -- /data) || return 1
	resolved="${parent%/}/${1##*/}"
	case "$resolved" in
		/run/archiso|/run/archiso/*|"$data_dir"|"$data_dir"/*)
			printf 'Refusing to copy mounted persistence data: %s (persist its symlink instead)\n' "$1" >&2
			return 1
			;;
	esac
}

indexed_files=()

check_conflicts() {
	local source="$1" saved="$pfs_dir/upperdir$1" child
	if [[ -e "$saved" || -L "$saved" ]]; then
		if { [[ -d "$source" && ! -L "$source" ]] && [[ ! -d "$saved" || -L "$saved" ]]; } ||
			{ [[ ! -d "$source" || -L "$source" ]] && [[ -d "$saved" && ! -L "$saved" ]]; }; then
			printf 'Type conflict in persistfs: %s; remove the saved entry explicitly first.\n' "$source" >&2
			return 1
		fi
	fi
	if [[ -d "$source" && ! -L "$source" ]]; then
		for child in "$source"/* "$source"/.[!.]* "$source"/..?*; do
			[[ -e "$child" || -L "$child" ]] || continue
			check_conflicts "$child" || return 1
		done
	fi
	return 0
}

index_add() {
	local entry
	for entry in "${indexed_files[@]}"; do
		[[ "$entry" = "$1" ]] && return 0
	done
	indexed_files+=( "$1" )
}

index_remove() {
	local entry
	local -a kept=()
	for entry in "${indexed_files[@]}"; do
		if [[ "$entry" != "$1" && "$entry" != "$1/"* ]]; then
			kept+=( "$entry" )
		fi
	done
	indexed_files=( "${kept[@]}" )
}

prune_empty_parents() {
	local parent=${1%/*}
	while [[ -n "$parent" && "$parent" != / ]]; do
		[[ ! -L "$pfs_dir/upperdir$parent" ]] || break
		rmdir -- "$pfs_dir/upperdir$parent" 2>/dev/null || break
		index_remove "$parent"
		parent=${parent%/*}
	done
}

load_index() {
	local entry delimiter=''
	[[ -e "$pfs_dir/upperdir/index" ]] || return 0
	# Read the old line-based index until the next mutation migrates it.
	IFS= read -r -d '' entry < "$pfs_dir/upperdir/index" || delimiter=$'\n'
	while IFS= read -r -d "$delimiter" entry || [[ -n "$entry" ]]; do
		[[ -n "$entry" ]] || continue
		absolute_path "$entry" || return 1
		index_add "$REPLY"
	done < "$pfs_dir/upperdir/index"
}

save_index() {
	local tmp
	tmp=$(mktemp "$pfs_dir/.index.XXXXXXXX") || return 1
	if [[ ${#indexed_files[@]} != 0 ]]; then
		printf '%s\0' "${indexed_files[@]}" > "$tmp" || { rm -f -- "$tmp"; return 1; }
	fi
	mv -fT -- "$tmp" "$pfs_dir/upperdir/index" || { rm -f -- "$tmp"; return 1; }
}

add_files() {
	local file
	local -a files=()

	for file in "$@"; do
		absolute_path "$file" || return 1
		file=$REPLY
		safe_path "$file" || return 1
		# Package files may have been removed by localepurge.
		[[ -e "$file" || -L "$file" ]] || continue
		safe_source "$file" || return 1
		check_conflicts "$file" || return 1
		files+=( "$file" )
	done

	[[ ${#files[@]} = 0 ]] && return 0
	if ! printf '%s\0' "${files[@]}" |
		rsync -arHAXq --delete-delay --mkpath --from0 --files-from=- / "$pfs_dir/upperdir"; then
		return 1
	fi

	for file in "${files[@]}"; do
		index_remove "$file"
		index_add "$file"
		printf 'Added %s to persistfs.\n' "$file"
	done
	save_index
}

actual_pkg() {
	local name="${1%%[<>=]*}" constraint candidate version provides provision
	local -a provided
	constraint=${1#"$name"}
	if version=$(LC_ALL=C pacman -Q -- "$name" 2>/dev/null); then
		version=${version#"$name "}
		if version_satisfies "$version" "$constraint"; then
			printf '%s\n' "$name"
			return 0
		fi
	fi
	while IFS=$'\t' read -r candidate provides; do
		IFS=' ' read -r -a provided <<< "$provides"
		for provision in "${provided[@]}"; do
			[[ "${provision%%=*}" = "$name" ]] || continue
			version=''
			[[ "$provision" = *=* ]] && version=${provision#*=}
			if version_satisfies "$version" "$constraint"; then
				printf '%s\n' "$candidate"
				return 0
			fi
		done
	done <<< "$provider_records"
	printf 'No installed package satisfies: %s\n' "$1" >&2
	return 1
}

version_satisfies() {
	local comparison expression='^(>=|<=|=|>|<)(.+)$'
	[[ -n "$2" ]] || return 0
	[[ -n "$1" && "$2" =~ $expression ]] || return 1
	comparison=$(vercmp "$1" "${BASH_REMATCH[2]}") || return 1
	case "${BASH_REMATCH[1]}" in
		'=') (( comparison == 0 )) ;;
		'>=') (( comparison >= 0 )) ;;
		'<=') (( comparison <= 0 )) ;;
		'>') (( comparison > 0 )) ;;
		'<') (( comparison < 0 )) ;;
	esac
}

package_db() {
	local version
	version=$(expac -Q '%v' "$1") || return 1
	[[ -n "$version" ]] || return 1
	REPLY="$pacmandb_dir/$1-$version"
	[[ -f "$REPLY/desc" && -f "$REPLY/files" ]]
}

db_name() {
	local field
	while IFS= read -r field; do
		[[ "$field" = %NAME% ]] || continue
		IFS= read -r REPLY && [[ -n "$REPLY" ]]
		return
	done < "$1"
	return 1
}

package_manifest() {
	local file section=0
	local -n manifest_paths=$2
	manifest_paths=()
	while IFS= read -r file; do
		if [[ "$file" = %*% ]]; then
			section=0
			[[ "$file" != %FILES% ]] || section=1
			continue
		fi
		[[ "$section" = 1 && -n "$file" ]] || continue
		case "/${file%/}/" in
			*//*|*/./*|*/../*)
				printf 'Invalid package path: %s\n' "$file" >&2
				return 1
				;;
		esac
		safe_path "/${file%/}" || return 1
		manifest_paths+=( "/$file" )
	done < "$1"
}

is_whiteout() {
	[[ ! -L "$1" && -c "$1" && $(stat -c '%t:%T' -- "$1") = 0:0 ]]
}

whiteout() {
	local path="$1" saved="$pfs_dir/upperdir$1"
	safe_path "$path" || return 1
	if ! is_whiteout "$saved"; then
		if [[ -d "$saved" && ! -L "$saved" ]]; then
			printf 'Refusing to whiteout saved directory: %s\n' "$path" >&2
			return 1
		fi
		mkdir -p -- "${saved%/*}" || return 1
		rm -f -- "$saved" || return 1
		mknod -- "$saved" c 0 0 || return 1
	fi
	index_remove "$path"
	index_add "$path"
}

clear_whiteouts() {
	local path="$1"
	safe_path "$path" || return 1
	while [[ -n "$path" && "$path" != / ]]; do
		if is_whiteout "$pfs_dir/upperdir$path"; then
			rm -f -- "$pfs_dir/upperdir$path" || return 1
			index_remove "$path"
		fi
		path=${path%/*}
	done
}

replace_package() {
	local pkg="$1" db="$2" root desc old_db file parent covered owner
	shift 2
	local -a current=() previous=() obsolete=() old_databases=()
	local -A current_paths=() current_files=() seen=()
	package_manifest "$db/files" current || return 1
	for file in "${current[@]}"; do
		current_paths[${file%/}]=1
		[[ "$file" = */ ]] || current_files[$file]=1
	done
	for root in "$airfs_dir" "$pfs_dir/upperdir"; do
		for desc in "$root$pacmandb_dir/$pkg-"*/desc; do
			[[ -f "$desc" ]] || continue
			db_name "$desc" || return 1
			[[ "$REPLY" = "$pkg" ]] || continue
			old_db=${desc%/desc}
			[[ "${old_db#"$root"}" != "$db" ]] || continue
			package_manifest "$old_db/files" previous || return 1
			old_databases+=( "${old_db#"$root"}" )
			for file in "${previous[@]}"; do
				[[ "$file" != */ && -z "${current_paths[$file]:-}" && -z "${seen[$file]:-}" ]] || continue
				seen[$file]=1
				# A new file replacing a directory already hides its old descendants.
				parent=${file%/*}
				covered=0
				while [[ -n "$parent" ]]; do
					[[ -z "${current_files[$parent]:-}" ]] || covered=1
					parent=${parent%/*}
				done
				[[ "$covered" = 0 ]] || continue
				# Do not hide paths now owned by another installed package.
				if owner=$(pacman -Qqo -- "$file" 2>/dev/null) && [[ "$owner" != "$pkg" ]]; then
					continue
				fi
				obsolete+=( "$file" )
			done
		done
	done
	for file in "${current[@]}" "$db/desc"; do
		clear_whiteouts "${file%/}" || return 1
	done
	add_files "$@" || return 1
	for file in "${obsolete[@]}"; do
		whiteout "$file" || return 1
	done
	for old_db in "${old_databases[@]}"; do
		safe_path "$old_db" || return 1
		rm -rf -- "$pfs_dir/upperdir$old_db" || return 1
		whiteout "$old_db" || return 1
	done
	save_index
}

case $1 in
	add|remove|pkg|list) load_index || exit 1 ;;
esac

case $1 in
	add)
		(( $# < 2 )) && echo Missing files to add >&2 && exit 1

		for file in "${@:2}"; do
			absolute_path "$file" || exit 1
			file=$REPLY
			safe_path "$file" || exit 1
			safe_source "$file" || exit 1
			if [[ ! -e "$file" && ! -L "$file" ]]; then
				echo File does not exist: $file >&2
				exit 1
			fi
		done

		add_files "${@:2}"
		;;
	remove)
		(( $# < 2 )) && echo Missing files to remove >&2 && exit 1
		statuscode=0

		for file in "${@:2}"; do
			absolute_path "$file" || exit 1
			file=$REPLY
			safe_path "$file" || exit 1
			if [ ! -L $pfs_dir/upperdir/"$file" -a ! -e $pfs_dir/upperdir/"$file" ]; then
				echo File does not exist: $file >&2
				statuscode=1
				continue
			fi

			rm -rf -- "$pfs_dir/upperdir$file" || exit 1
			index_remove "$file"
			prune_empty_parents "$file"
			save_index || exit 1
		done

		exit $statuscode
		;;
	pkg)
		[ -z "$2" ] && echo Missing package to install && exit 1

		provider_records=$(expac -Q -l ' ' $'%n\t%P') || exit 1
		declare -A visited_packages=()
		add_pkg_files() {
			local pkg dep db listing file dependencies
			local -a files=()
			pkg=$(actual_pkg "$1") || return 1
			[[ -z "${visited_packages[$pkg]:-}" ]] || return 0
			visited_packages[$pkg]=1
			package_db "$pkg" || return 1
			db=$REPLY
			listing=$(pacman -Qql -- "$pkg") || return 1
			while IFS= read -r file; do
				[[ -z "$file" || "$file" = */ ]] || files+=( "$file" )
			done <<< "$listing"
			files+=( "$db/desc" "$db/files" )
			[[ ! -f "$db/mtree" ]] || files+=( "$db/mtree" )
			replace_package "$pkg" "$db" "${files[@]}" || return 1

			dependencies=$(expac -Q -l $'\n' '%D' "$pkg") || return 1
			while IFS= read -r dep; do
				[[ -n "$dep" ]] || continue
				dep=$(actual_pkg "$dep") || return 1
				package_db "$dep" || return 1
				if [[ ! -f "$pfs_dir/upperdir$REPLY/desc" && ! -f "$airfs_dir$REPLY/desc" ]]; then
					add_pkg_files "$dep" || return 1
				fi
			done <<< "$dependencies"
		}

		for pkg in "${@:2}"; do
			add_pkg_files "$pkg" || exit 1
		done
		;;
	ipkg)
		[ -z "$2" ] && echo Missing package to install >&2 && exit 1

		for pkg in "${@:2}"; do
			pacman -S "$pkg" || exit 1
			"$0" pkg "$pkg" || exit 1
		done
		;;
	diff)
		[ -z "$2" ] && echo Missing file to diff >&2 && exit 1

		file="$2"
		if [ ! "${file:0:1}" = / ]; then
			file="$(pwd)/$file"
		fi

		[ ! -e $airfs_dir/"$file" ] && echo File does not exist >&2 && exit 1
		[ ! -e $pfs_dir/upperdir/"$file" ] && echo File not in persistfs >&2 && exit 1

		diff -u $airfs_dir/"$file" $pfs_dir/upperdir/"$file" | bat --file-name "$file"
		;;
	list)
		all=0
		packages=0
		format='%s\n'
		for option in "${@:2}"; do
			case "$option" in
				--all) all=1 ;;
				--packages) packages=1 ;;
				--null) format='%s\0' ;;
				*) printf 'Unknown list option: %s\n' "$option" >&2; exit 1 ;;
			esac
		done
		if [[ "$packages" = 1 ]]; then
			declare -A listed_packages=()
			for desc in "$pfs_dir/upperdir$pacmandb_dir"/*/desc; do
				[[ -f "$desc" ]] || continue
				db_name "$desc" || exit 1
				pkg=$REPLY
				if [[ -z "${listed_packages[$pkg]:-}" ]]; then
					printf "$format" "$pkg"
					listed_packages[$pkg]=1
				fi
			done
			exit 0
		fi
		declare -A package_paths=()
		if [[ "$all" = 0 ]]; then
			for manifest in "$pfs_dir/upperdir$pacmandb_dir"/*/files; do
				[[ -f "$manifest" ]] || continue
				package_manifest "$manifest" paths || exit 1
				for file in "${paths[@]}"; do package_paths[${file%/}]=1; done
			done
		fi
		for file in "${indexed_files[@]}"; do
			if [[ "$all" = 0 ]]; then
				[[ "$file" = "$pacmandb_dir/"* ]] && continue
				[[ -n "${package_paths[$file]:-}" ]] && continue
				is_whiteout "$pfs_dir/upperdir$file" && continue
				if [[ ! -e "$airfs_dir$file" && ! -L "$airfs_dir$file" ]]; then
					pacman -Qqo -- "$file" >/dev/null 2>&1 && continue
				fi
			fi
			printf "$format" "$file"
		done
		;;
	*)
		echo usage: "$0 [add|remove|pkg|ipkg|diff|list] [--all] [--packages] [--null]" >&2
		echo
		echo \ add: add a file to persistfs.
		echo
		echo \ remove: remove a file from persistfs.
		echo
		echo \ pkg: copy an existing pacman package to persistfs.
		echo
		echo \ ipkg: install a package with pacman -S and copy it to persistfs.
		echo
		echo \ diff: show a diff between a file in the airootfs and in the persistfs.
		echo
		echo \ list: list non-package files and overrides of system files in the persistfs.
		echo \ \ use --all to include all package files, or --packages to list saved package names instead.
		echo \ \ use --null for NUL-separated output.
		exit 1
		;;
esac
