#!/bin/bash

# generate a 1 second blank video
ffmpeg -f lavfi \
	-i color=c=black:s=640x480:d=1 \
	-c:v libx264 \
	-tune stillimage \
	-pix_fmt yuv420p \
	/tmp/output.mp4 >/dev/null 2>&1

mpv-hardened --loop-file=inf /tmp/output.mp4 >/tmp/mpv.log 2>&1 &
player=$!
sleep 3
if ! kill -0 "$player" 2>/dev/null; then
	if wait "$player"; then
		status=0
	else
		status=$?
	fi
	echo "mpv exited unexpectedly ($status)" >&2
	cat /tmp/mpv.log >&2
	exit 1
fi
kill "$player"
wait "$player" || :
