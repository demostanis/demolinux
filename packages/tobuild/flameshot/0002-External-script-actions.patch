+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <QObject>
+#include <QProcess>
+#include <QStringList>
+#include <QTimer>
+#include <QVector>
+
+struct ExternalAction
+{
+    QString name;
+    QString program;
+    QStringList arguments;
+    QString shortcut;
+    QString icon;
+    int timeout = 60000;
+};
+
+QVector<ExternalAction> loadExternalActions();
+
+class ExternalActionRunner : public QObject
+{
+    Q_OBJECT
+public:
+    explicit ExternalActionRunner(QObject* parent = nullptr);
+    ~ExternalActionRunner() override;
+    bool start(const ExternalAction& action, const QByteArray& png);
+    bool running() const { return m_running; }
+    void cancel();
+
+signals:
+    void finished(bool success, const QString& message);
+
+private:
+    void finish(bool success, const QString& message);
+    QProcess m_process;
+    QTimer m_timer;
+    QByteArray m_png;
+    QString m_failure;
+    bool m_running = false;
+};
