@@ -0,0 +1,96 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  capture: vi.fn(),
+  build: vi.fn(),
+  options: [] as string[][],
+}));
+
+vi.mock('node:child_process', () => ({ spawnSync: mocks.capture }));
+vi.mock('selenium-webdriver', () => ({
+  Browser: { FIREFOX: 'firefox' },
+  Builder: class {
+    forBrowser() {
+      return this;
+    }
+    setFirefoxOptions() {
+      return this;
+    }
+    build = mocks.build;
+  },
+}));
+vi.mock('selenium-webdriver/firefox.js', () => ({
+  default: {
+    Options: class {
+      args: string[] = [];
+      constructor() {
+        mocks.options.push(this.args);
+      }
+      enableBidi() {}
+      addArguments(...args: string[]) {
+        this.args.push(...args);
+      }
+    },
+  },
+}));
+
+import { FirefoxCore } from '../../src/firefox/core.js';
+
+describe.runIf(process.platform === 'linux')('Firefox sidewindow capture', () => {
+  beforeEach(() => {
+    vi.stubEnv('DISPLAY', ':0');
+    mocks.options.length = 0;
+    mocks.capture.mockReset().mockReturnValue({ status: 0 });
+    mocks.build.mockReset().mockResolvedValue({
+      getWindowHandle: vi.fn().mockResolvedValue('context'),
+    });
+  });
+  afterEach(() => vi.unstubAllEnvs());
+
+  it('passes each ID and unique launch class before and after browser creation', async () => {
+    const first = new FirefoxCore({ headless: false, instanceId: 'agent-a' });
+    const second = new FirefoxCore({ headless: false, instanceId: 'agent-b' });
+    await Promise.all([first.connect(), second.connect()]);
+
+    const classes = mocks.options.map((args) => args[args.indexOf('--class') + 1]);
+    expect(classes[0]).toMatch(/^opencode-firefox-mcp-[a-f0-9-]+$/);
+    expect(classes[0]).not.toBe(classes[1]);
+    for (const [index, id] of ['agent-a', 'agent-b'].entries()) {
+      const calls = mocks.capture.mock.calls.filter((call) => call[1][2] === id);
+      expect(calls).toHaveLength(2);
+      expect(calls[0]).toEqual([
+        'opencode-sidewindow-ctl',
+        ['capture-firefox', '--id', id, '--window-class', classes[index]],
+        { stdio: 'ignore', timeout: 2000 },
+      ]);
+      expect(calls[1]).toEqual(calls[0]);
+    }
+    expect(mocks.capture.mock.invocationCallOrder[0]).toBeLessThan(
+      mocks.build.mock.invocationCallOrder[0]!
+    );
+  });
+
+  it('uses the default ID for direct callers', async () => {
+    await new FirefoxCore({ headless: false }).connect();
+    expect(mocks.capture.mock.calls[0]![1][2]).toBe('default');
+  });
+
+  it('does not capture headless browsers', async () => {
+    await new FirefoxCore({ headless: true, instanceId: 'agent-a' }).connect();
+    expect(mocks.capture).not.toHaveBeenCalled();
+    expect(mocks.options[0]).toEqual(['-headless']);
+  });
+
+  it('does not capture when X11 is unavailable', async () => {
+    vi.stubEnv('DISPLAY', '');
+    await new FirefoxCore({ headless: false }).connect();
+    expect(mocks.capture).not.toHaveBeenCalled();
+    expect(mocks.options[0]).toEqual([]);
+  });
+
+  it('still launches when sidewindow controls are unavailable', async () => {
+    mocks.capture.mockReturnValue({ error: new Error('ENOENT'), status: null });
+    await new FirefoxCore({ headless: false }).connect();
+    expect(mocks.build).toHaveBeenCalledOnce();
+  });
+});
