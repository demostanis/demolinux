pkgname=opencode
pkgver=1.2.20
pkgrel=6
pkgdesc='The open source coding agent'
arch=('x86_64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
depends=(
  'curl'
  'gcc-libs'
  'glibc'
  'icu'
  'ripgrep'
  'tar'
)
makedepends=(
  'bun'
  'git'
)
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'xclip: clipboard support on X11'
)
options=(
  '!debug'
  '!strip'
)
_opentui_ver=0.1.79
source=(
  "https://github.com/anomalyco/opencode/archive/refs/tags/v$pkgver.tar.gz"
  "opentui-$_opentui_ver.tar.gz::https://github.com/anomalyco/opentui/archive/refs/tags/v$_opentui_ver.tar.gz"
  "fix-motion-events.patch"
  "fix-tools-first-launch.patch"
  "hide-migration-logs.patch"
  "loading-messages.patch"
  "strip-ansi-output.patch"
)
