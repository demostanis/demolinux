#!/bin/bash

# Pixel assertions need this workaround; other shards do not need full-screen
# redraws every second on the software-rendered QEMU display.
while true; do xrefresh; sleep 1; done >/dev/null 2>&1 &

expect_middle_color() {
	mc=
	tries=${2:-10}
	for i in {1..$tries}; do
		mc=$(import -window root png:- | magick png:- -format "%[pixel:p{%[fx:int(w/2)],%[fx:int(h/2)]}]" info:)

		if [ "$mc" = "$1" ]; then
			return
		fi
		sleep 1
	done
	echo expected color at the middle of the screen to be $1 but got $mc
	exit 1
}

yad --title='GTK theme test' &
expectwin 'GTK theme test'
expectfocus 'GTK theme test'
expect_middle_color "srgb(26,9,45)"
quitwin

kdeconnect-app >/dev/null 2>&1 &
expectwin 'KDE Connect'
expectfocus "KDE Connect"
expectviewport
modkeypress w
expectawesome 'return client.focus.width > client.focus.screen.geometry.width * 0.85'
expect_middle_color "srgb(51,15,65)"
quitwin

urxvt -title 'theme left' -e sleep infinity &
expectwin 'theme left'
expectfocus 'theme left'
expectviewport
urxvt -title 'theme right' -e sleep infinity &
expectwin 'theme right'
expectfocus 'theme right'
expectviewport
modkeypress h
expectfocus 'theme left'
expectviewport
modkeypress minus

resize_focused_window() {
	local x y
	read -r x y < <(awesome-client '
		local c = client.focus
		return string.format("%d %d", c.x + c.width - 20, math.floor(c.y + c.height / 2))
	' | cut -d '"' -f 2)
	# The screen midpoint can be outside the terminal after a viewport scroll.
	xdotool mousemove --sync "$x" "$y" sleep 0.2 \
		keydown Super_L mousedown 3 sleep 0.2 \
		mousemove_relative -- "$1" 0 sleep 0.2 \
		mouseup 3 keyup Super_L
}

# resizes window to the right (bigger)
resize_focused_window 200
# focused terminal
expect_middle_color "srgb(30,5,40)"

# resizes window to the left (smaller)
resize_focused_window -500
# unfocused terminal
expect_middle_color "srgb(21,4,28)"

quitwin
quitwin
