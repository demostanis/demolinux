#!/bin/bash

modkeypress p
xdotool key w
expectwin iwgtk
quitwin

modkeypress p
orig=$(curl -4 icanhazip.com)
xdotool key v

tries=10
success=
for i in {1..$tries}; do
	sleep 5
	new=$(curl -4 icanhazip.com) || continue
	if [ "$orig" != "$new" ]; then
		success=y
		break
	fi
done
if [ -z "$success" ]; then
	echo RiseupVPN is broken, can\'t connect >&2
	exit 1
fi

modkeypress p
xdotool key v
sleep 5

new=$(curl -4 icanhazip.com)
if [ "$new" != "$orig" ]; then
	echo RiseupVPN is broken, can\'t disconnect >&2
	exit 1
fi

wait_for_recorder_status() {
	local expected=$1
	local actual
	for _ in {1..100}; do
		actual=$(screenrecord status)
		[ "$actual" = "$expected" ] && return
		sleep 0.1
	done
	echo "screen recorder did not reach '$expected' state (got '$actual')" >&2
	return 1
}

recording=
cleanup_recording_test() {
	screenrecord stop >/dev/null 2>&1 || :
	[ -n "$recording" ] && rm -f "$recording"
	rm -f record.mp4
}
trap cleanup_recording_test EXIT

screenrecord stop
wait_for_recorder_status "Not recording"

modkeypress p
xdotool key r
wait_for_recorder_status "Recording..."
sleep 2
xdotool key r
wait_for_recorder_status "Not recording"
xdotool key Escape

recording=$(screenrecord output)
[ -n "$recording" ]
[ -s "$recording" ]
ffprobe -v error -select_streams v:0 \
	-show_entries stream=codec_name,width,height \
	-of default=noprint_wrappers=1 "$recording"
mv "$recording" record.mp4
recording=
xdg-open record.mp4 >/dev/null 2>&1 & sleep 1
expectwin 'record.mp4 - mpv'
quitwin

modkeypress p
xdotool key c
sleep 1
xdotool click 1
expectwin 'Color picker'
quitwin
