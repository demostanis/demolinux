{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-pty"
  ],
  "mcp": {
    "firefox": {
      "type": "local",
      "command": [
        "firefox-devtools-mcp", "--firefox-path",
        "/usr/local/bin/firefox-hardened", "--profile-path",
        "/home/demostanis/.mozilla/firefox/default.profile"
      ]
    }
  },
  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/*": "allow"
    }
  }
}
