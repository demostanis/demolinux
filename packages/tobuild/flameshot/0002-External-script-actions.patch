+void CaptureWidget::initExternalActions(QVector<CaptureToolButton*>& buttons)
+{
+    const auto actions = loadExternalActions();
+    if (actions.isEmpty()) {
+        return;
+    }
+    m_externalActionRunner = new ExternalActionRunner(this);
+    for (const auto& action : actions) {
+        const QIcon icon = QIcon::fromTheme(action.icon,
+          style()->standardIcon(QStyle::SP_ArrowForward));
+        const auto sequence = QKeySequence(action.shortcut, QKeySequence::PortableText);
+        const QString tooltip = action.name + (sequence.isEmpty() ? QString()
+          : QStringLiteral(" (%1)").arg(sequence.toString(QKeySequence::NativeText)));
+        auto* button = new CaptureToolButton(icon, tooltip, this);
+        button->setObjectName("externalActionButton");
+        button->setColor(m_uiColor);
+        button->setAttribute(Qt::WA_NoMousePropagation);
+        button->hide();
+        makeChild(button);
+        buttons.append(button);
+        m_externalActionButtons.append(button);
+        auto invoke = [this, action, button]() { runExternalAction(action, button); };
+        connect(button, &CaptureToolButton::pressedButtonLeftClick, this, invoke);
+        if (!sequence.isEmpty()) {
+            auto* shortcut = new QShortcut(sequence, this);
+            shortcut->setAutoRepeat(false);
+            connect(shortcut, &QShortcut::activated, this, invoke);
+        }
+        connect(m_externalActionRunner, &ExternalActionRunner::finished, button,
+                [button, icon, tooltip](bool, const QString&) {
+            button->setEnabled(true);
+            button->setActionPresentation(icon, tooltip);
+        });
+    }
+    connect(m_externalActionRunner, &ExternalActionRunner::finished, this,
+            [this](bool success, const QString& message) {
+        m_runningActionButton = nullptr;
+        if (success) {
+            m_captureDone = true;
+            close();
+        } else {
+            showExternalActionMessage(message);
+        }
+    });
+    m_externalActionsStatus = new QLabel(this);
+    m_externalActionsStatus->setObjectName("externalActionsStatus");
+    m_externalActionsStatus->setTextFormat(Qt::PlainText);
+    m_externalActionsStatus->setWordWrap(true);
+    m_externalActionsStatus->setMargin(8);
+    m_externalActionsStatus->setFixedWidth(qMin(420, width() - 24));
+    m_externalActionsStatus->setAutoFillBackground(true);
+    auto palette = m_externalActionsStatus->palette();
+    palette.setColor(QPalette::Window, palette.color(QPalette::ToolTipBase));
+    palette.setColor(QPalette::WindowText, palette.color(QPalette::ToolTipText));
+    m_externalActionsStatus->setPalette(palette);
+    m_externalActionsStatus->setAttribute(Qt::WA_TransparentForMouseEvents);
+    auto* statusTimer = new QTimer(m_externalActionsStatus);
+    statusTimer->setSingleShot(true);
+    connect(statusTimer, &QTimer::timeout, m_externalActionsStatus, &QLabel::hide);
+    makeChild(m_externalActionsStatus);
+    m_externalActionsStatus->move(mapFromGlobal(QGuiAppCurrentScreen().currentScreen()->geometry().topLeft()) + QPoint(12, 12));
+    m_externalActionsStatus->hide();
+}
+
+void CaptureWidget::showExternalActionMessage(const QString& message)
+{
+    m_externalActionsStatus->setText(message);
+    m_externalActionsStatus->adjustSize();
+    m_externalActionsStatus->show();
+    m_externalActionsStatus->raise();
+    m_externalActionsStatus->findChild<QTimer*>()->start(5000);
+}
+
+void CaptureWidget::runExternalAction(const ExternalAction& action, CaptureToolButton* button)
+{
+    if (m_externalActionRunner->running()) {
+        if (button == m_runningActionButton) {
+            m_externalActionRunner->cancel();
+        }
+        return;
+    }
+    if (m_context.selection.isEmpty()) {
+        showExternalActionMessage(tr("Select an area before running an external action"));
+        return;
+    }
+    commitCurrentTool();
+    drawToolsData(false);
+    QByteArray png;
+    QBuffer buffer(&png);
+    buffer.open(QIODevice::WriteOnly);
+    if (!pixmap().save(&buffer, "PNG") ||
+        !m_externalActionRunner->start(action, png)) {
+        showExternalActionMessage(tr("Could not encode PNG (maximum 64 MiB)"));
+    } else {
+        m_runningActionButton = button;
+        for (auto* other : m_externalActionButtons) {
+            other->setEnabled(other == button);
+        }
+        button->setActionPresentation(style()->standardIcon(QStyle::SP_DialogCancelButton),
+          tr("Cancel %1").arg(button->toolTip()));
+        showExternalActionMessage(tr("Running external action: %1 (click its icon to cancel)").arg(action.name));
     }
 }

