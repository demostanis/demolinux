+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+describe('startup URL', () => {
+  beforeEach(() => {
+    vi.resetModules();
+    vi.stubEnv('START_URL', undefined);
+  });
+
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    vi.resetModules();
+  });
+
+  it('defaults to a page Firefox WebDriver allows navigating to', async () => {
+    const { parseArguments, cliOptions } = await import('../src/cli.js');
+    const args = parseArguments('test', ['node', 'firefox-devtools-mcp']);
+
+    expect(args.startUrl).toBe('about:blank');
+    expect(cliOptions.startUrl.description).toContain('default: about:blank');
+  });
+
+  it('preserves the START_URL environment override', async () => {
+    vi.stubEnv('START_URL', 'https://example.com/from-env');
+    const { parseArguments } = await import('../src/cli.js');
+
+    expect(parseArguments('test', ['node', 'firefox-devtools-mcp']).startUrl)
+      .toBe('https://example.com/from-env');
+  });
+
+  it('prefers an explicit start URL over the environment', async () => {
+    vi.stubEnv('START_URL', 'https://example.com/from-env');
+    const { parseArguments } = await import('../src/cli.js');
+    const args = parseArguments('test', [
+      'node', 'firefox-devtools-mcp', '--start-url', 'https://example.com/from-cli',
+    ]);
+
+    expect(args.startUrl).toBe('https://example.com/from-cli');
+  });
+});
