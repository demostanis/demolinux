Subject: [PATCH] Enable XKB without exposing other clients keyboard state

Allow keymap queries and client-local flags. Check focus when reading or
delivering keyboard state, since XKB notifications bypass ordinary window
event checks. Reject untrusted global keyboard configuration changes.

--- a/Xext/security.c
+++ b/Xext/security.c
@@ -32,6 +32,7 @@
 #include "inputstr.h"
 #include "exglobals.h"
 #include <X11/extensions/XI2.h>
+#include <X11/extensions/XKBproto.h>
 #include "windowstr.h"
 #include "propertyst.h"
 #include "colormapst.h"
@@ -91,6 +92,7 @@
     "BIG-REQUESTS",
     "Generic Event Extension",
     "XInputExtension",
+    "XKEYBOARD",
