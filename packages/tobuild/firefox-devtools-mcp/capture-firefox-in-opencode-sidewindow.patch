+function captureFirefoxInOpenCodeSidewindow(): void {
+  if (process.platform !== 'linux' || !process.env.DISPLAY) {
+    return;
+  }
+
+  const result = spawnSync('opencode-sidewindow', ['capture-firefox'], {
+    stdio: 'ignore',
+    timeout: 2000,
+  });
+  if (result.error) {
+    logDebug(`OpenCode sidewindow capture unavailable: ${result.error.message}`);
+  } else if (result.status !== 0) {
+    logDebug(
+      `OpenCode sidewindow capture exited with status ${result.status ?? 'unknown'}`,
+    );
+  }
+}
