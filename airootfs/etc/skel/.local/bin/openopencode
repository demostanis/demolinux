#!/bin/sh

export DISPLAY=:0
# ???????????
export LANG=en_US.UTF-8

prompt="$1"
instance="$2"
[ -n "$instance" ] && instance="$instance"$

cd "$(mktemp -d)"

was_locked=
if awesome-client 'return screen_locked' | grep -q true; then
	~/.local/bin/hide_screenlock
	was_locked=y
fi

w=$(xdotool search --name '^OC \| '"$instance")
if [ "$instance" != "New session$" -a -n "$w" ]; then
	if [ $(echo "$w" | wc -l) != 1 ]; then
		echo ambiguous...
		exit 1
	fi
	xdotool windowactivate "$w"
	sleep 2
else
	orig=$(xwininfo -root -tree | grep "OpenCode" | wc -l)
	nohup urxvt -e opencode --yolo --agent build >/dev/null 2>&1 &
	for i in {1..20}; do
		new=$(xwininfo -root -tree | grep "OpenCode"  | wc -l)
		[ "$new" != "$orig" ] && break
		sleep 1
	done
fi

xdotool type "$prompt. Notify my phone when done."
xdotool key Enter

if [ -n "$was_locked" ]; then
	~/.local/bin/screenlock
fi
