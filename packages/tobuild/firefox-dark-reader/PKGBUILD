# Maintainer: Daniel M. Capella <polyzen@archlinux.org>
# Contributor: Cookie Engineer <cookiengineer@protonmail.ch>

pkgname='firefox-dark-reader'
_pkgbase=dark-reader
_name=${_pkgbase/-}
pkgver=4.9.121
pkgrel=2
pkgdesc='Inverts brightness of web pages and aims to reduce eyestrain while browsing the web'
arch=('any')
url=https://darkreader.org/
groups=('firefox-addons')
license=('MIT')
makedepends=('git' 'npm')
source=("git+https://github.com/$_name/$_name.git#tag=v$pkgver"
        '0001-dark-popup-first-paint.patch')
b2sums=('SKIP'
        'f00d67dcb07a548ccbfa57e271d319a1406d382c84bd9644196e81dde2cfcc683e75ddca7dca28008a9893ce34824011f60da92fe476dd58e0a8045c3f381ac9')

prepare() {
  cd "$_name"
  patch -Np1 -i "$srcdir/0001-dark-popup-first-paint.patch"
  sed -i 's/enableForProtectedPages: false/enableForProtectedPages: true/'  src/defaults.ts
  npm i # npm ci alone warns that package.json and package-lock.json aren't in sync?
  npm ci
}

build() {
  cd "$_name"
  npm run build
}

check() {
  cd "$_name"
  npm test
}

package() {
  cd "$_name"/build/release
  install -Dm644 "$_name"-firefox.xpi \
    "$pkgdir"/usr/lib/firefox/browser/extensions/addon@"$_name".org.xpi
}
