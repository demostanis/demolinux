+        return BadAccess;

     interest = XkbFindClientResource((DevicePtr) dev, client);
     if (stuff->change) {
--- a/xkb/xkbEvents.c
+++ b/xkb/xkbEvents.c
@@ -40,6 +40,21 @@
 #include "windowstr.h"
 #include <xkbsrv.h>
 #include "xkb.h"
+#include "xace.h"
+
+Bool
+XkbClientCanReadState(ClientPtr client, DeviceIntPtr dev)
+{
+    /* Extended devices may carry keyboard LED state without being keyboards. */
+    if (!IsKeyboardDevice(dev)) {
+        dev = GetMaster(dev, MASTER_KEYBOARD);
+        if (!dev)
+            dev = inputInfo.keyboard;
+    }
+    return XaceHook(XACE_DEVICE_ACCESS, client, dev,
+                    DixReadAccess | DixReceiveAccess) == Success;
+}
+

