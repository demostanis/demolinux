#!/bin/bash

prompt="write ONLY yes if you are working correctly"

run_model() {
	local result=0
	timeout 120 opencode run --format json -m "opencode/$1" "$prompt" \
		</dev/null >"/tmp/opencode-$2.jsonl" || result=$?
	jq -Rj 'fromjson? | select(.type? == "text") | .part.text? | strings' \
		"/tmp/opencode-$2.jsonl" || result=$?
	rm -f "/tmp/opencode-$2.jsonl"
	return "$result"
}

model=big-pickle
out=$(run_model "$model" primary) || :

if ! grep -q yes <<<"$out"; then
	model=$(curl -fsSL --max-time 30 https://models.dev/api.json | jq -r '
		.opencode.models
		| to_entries[]
		| select(.key != "big-pickle")
		| select((.value.status // "") != "deprecated")
		| select((.value.cost.input // -1) == 0 and (.value.cost.output // -1) == 0)
		| .key
	' | shuf -n1)

	if [ -z "$model" ]; then
		echo "could not pick a free opencode model from models.dev" >&2
		exit 1
	fi

	out=$(run_model "$model" fallback) || :
fi

if ! grep -q yes <<<"$out"; then
	echo "$model in opencode didn't run" >&2
	exit 1
fi
