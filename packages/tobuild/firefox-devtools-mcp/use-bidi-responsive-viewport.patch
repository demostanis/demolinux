+/**
+ * Unit tests for page management
+ */
+
+import { describe, expect, it, vi } from 'vitest';
+import type { WebDriver } from 'selenium-webdriver';
+import { PageManagement } from '@/firefox/pages.js';
+
+describe('PageManagement', () => {
+  describe('setViewportSize', () => {
+    it('uses BiDi viewport emulation without resizing the browser window', async () => {
+      const getWindowHandle = vi.fn().mockResolvedValue('context-123');
+      const manage = vi.fn();
+      const driver = { getWindowHandle, manage } as unknown as WebDriver;
+      const setViewport = vi.fn().mockResolvedValue(undefined);
+      const createViewportContext = vi.fn().mockResolvedValue({ setViewport });
+      const pages = new PageManagement(driver, () => null, vi.fn(), createViewportContext);
+
+      await pages.setViewportSize(390, 844);
+
+      expect(getWindowHandle).toHaveBeenCalledOnce();
+      expect(createViewportContext).toHaveBeenCalledWith(driver, {
+        browsingContextId: 'context-123',
+      });
+      expect(setViewport).toHaveBeenCalledWith(390, 844);
+      expect(manage).not.toHaveBeenCalled();
+    });
+  });
+});
