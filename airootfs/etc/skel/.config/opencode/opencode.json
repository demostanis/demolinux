{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest"
  ],
  "theme": "system",
  "tui": {
    "scroll_acceleration": {
      "enabled": false
    }
  },
  "mcp": {
    "chrome-devtools-mcp": {
      "type": "local",
      "command": [
        "npx", "-y",
        "chrome-devtools-mcp@latest",
        "-e", "/usr/bin/chromium"
      ]
    }
  }
}
