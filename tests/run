#!/bin/zsh

stop_vm() {
	echo stopping demolinux...
	if [[ -n "$vm_pid" ]]; then
		kill "$vm_pid" 2>/dev/null || :
		wait "$vm_pid" 2>/dev/null || :
		vm_pid=
	fi
	ssh -p "${DEMOLINUX_SSH_PORT:-60022}" -S "$DEMOLINUX_SSH_CONTROL_PATH" -O exit demostanis@localhost 2>/dev/null || :
	rm -rf -- "$control_dir"
	echo "VM harness took $SECONDS seconds"
}

die() {
	[ $# != 0 ] && echo "$*" >&2
	timeout 5 python3 .github/qmp-screenshot.py "$log_dir/boot.png" || :
	echo awesome log:
	timeout 2 ./dctrl shell 'cat ~/.awesome.log /tmp/mpv.log /tmp/record-playback.log 2>/dev/null' | tee "$log_dir/awesome.log"
	timeout 3 ./dctrl pull /data/screenshot.png "$log_dir/screenshot.png"
	echo tests failed
	exit 1
}

cd "$(dirname "$(realpath "$0")")"/..
set -o pipefail
log_dir=${DEMOLINUX_TEST_LOG_DIR:-.}
mkdir -p -- "$log_dir"
vm_log="$log_dir/console.log"
control_dir=$(mktemp -d)
export DEMOLINUX_SSH_CONTROL_PATH="$control_dir/ssh"
vm_pid=
trap stop_vm EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

image=${DEMOLINUX_TEST_IMAGE:-}
if [[ -z "$image" ]]; then
	images=(out/demolinux*.img(Nom))
	(( ${#images} )) || die 'No image found. Run ./demolinux build first.'
	image=$images[1]
fi
./bin/run_archiso -S -T 10G -H -i "$image" > >(cat -v | tee "$vm_log") 2>&1 &
vm_pid=$!

# can't use timeout 60 zsh -c ... since signal
# handlers won't be called...
start=$(date +%s)
while :; do
	now=$(date +%s)
	if ! kill -0 "$vm_pid" 2>/dev/null; then
		die 'VM process exited before SSH became available.'
	fi
	if (( now - start >= ${DEMOLINUX_BOOT_TIMEOUT:-240} )); then
		die "VM did not start after ${DEMOLINUX_BOOT_TIMEOUT:-240} seconds."
	fi

	[ -t ] && reset
	echo waiting for guest...
	timeout 2 ./dctrl shell "exit 42"
	# this is mystery...
	ret=$?
	[ $ret = 42 ] && break
	sleep 1
done

echo running demolinux tests...
echo "VM SSH ready after $((now - start)) seconds"
if ! timeout 30 ./dctrl shell <<EOC; then
while :; do
	if grep 'awesomeWM started' ~/.awesome.log 2>/dev/null; then
		exit
	fi
	sleep 1
done
EOC
	die AwesomeWM did not start after 30 seconds.
fi

echo changing display resolution...
./dctrl shell 'DISPLAY=:0 /usr/lib/xrandr.sh >/dev/null 2>&1'

# for the screen to refresh
sleep 5

selected=("$@")
if (( $# == 0 )); then
	selected=(${${(f)"$(find tests -mindepth 1 -maxdepth 1 ! -name run ! -name utils)"}#tests/})
fi
# One connection and one stream instead of an scp handshake for every test.
tar -C tests -cf - -- "${selected[@]}" utils | ./dctrl shell 'mkdir -p /tmp/tests && tar -xf - -C /tmp/tests' || die 'Could not transfer tests.'

./dctrl shell <<'EOC' || die

export DISPLAY=:0
cd /tmp/tests
. ./utils

# A descheduled xdotool process can otherwise turn a single key into repeats.
xset r off

# These headless VMs have no accelerated GPU; keep rendering deterministic.
printf '\nvo=x11\n' >> ~/.config/mpv/mpv.conf || exit 1

while read -r test; do
	if [ "$test" != ./run -a "$test" != ./utils \
		-a "$test" != ./sysupdate -a "$test" != ./sysupdate_snapshot ]; then
		echo "running $test at guest +${SECONDS}s..."
		(
			set -ex
			trap '
				xrefresh
				import -window root png:- > /data/screenshot.png
				kill ${${(v)jobstates##*:*:}%=*} 2>/dev/null || :
			' EXIT
			. "$test"
		) </dev/null
		if [ $? != 0 ]; then
			echo $test failed 2>&1
			exit 1
		fi
	fi
done < <(find . -type f -executable | sort)

EOC

if [[ $# == 0 || "$*" == *sysupdate* ]]; then
	./dctrl shell "sudo mount -o remount,rw /run/archiso/bootmnt"
	./dctrl shell "sudo sed -i s/timeout=5/timeout=-1/ /run/archiso/bootmnt/grub/grub.cfg"

	# will reboot the VM
	timeout 15 ./dctrl shell "cd /tmp/tests && nohup /bin/bash ./sysupdate >/data/sysupdate-test.log 2>&1 </dev/null &"

	tries=120
	found=
	for i in {1..$tries}; do
		if grep -q 'sysupdate test succeeded' "$vm_log"; then
			found=y
			break
		fi
		sleep 1
	done
	[ -z "$found" ] && die sysupdate failed

	sleep 10 # time to get in the grub menu
	( . ./tests/sysupdate_snapshot )
	ret=$?
	if [ "$ret" != 0 ]; then
		die sysupdate snapshot failed
	fi
fi

echo all tests succeeded
