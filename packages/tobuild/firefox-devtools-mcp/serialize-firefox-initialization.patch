@@ -0,0 +1,51 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+const connection = vi.hoisted(() => {
+  let resolveConnection: () => void;
+  const pendingConnection = new Promise<void>((resolve) => {
+    resolveConnection = resolve;
+  });
+
+  return {
+    connect: vi.fn(() => pendingConnection),
+    isConnected: vi.fn().mockResolvedValue(false),
+    reset: vi.fn(),
+    resolve: () => resolveConnection(),
+  };
+});
+
+vi.mock('../src/cli.js', () => ({
+  parseArguments: () => ({
+    headless: true,
+    acceptInsecureCerts: false,
+  }),
+}));
+
+vi.mock('../src/firefox/index.js', () => ({
+  FirefoxDevTools: class {
+    connect = connection.connect;
+    isConnected = connection.isConnected;
+    reset = connection.reset;
+  },
+}));
+
+import { getFirefox, resetFirefox } from '../src/index.js';
+
+describe('Firefox initialization', () => {
+  afterEach(() => {
+    resetFirefox();
+  });
+
+  it('shares one launch between concurrent tool requests', async () => {
+    const first = getFirefox();
+    const second = getFirefox();
+
+    expect(connection.connect).toHaveBeenCalledTimes(1);
+
+    connection.resolve();
+    const [firstClient, secondClient] = await Promise.all([first, second]);
+
+    expect(firstClient).toBe(secondClient);
+    expect(connection.connect).toHaveBeenCalledTimes(1);
+  });
+});
