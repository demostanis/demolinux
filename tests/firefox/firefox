#!/bin/bash

echo starting firefox...

# why does exec stop the process with set -e??
exec 2> >( sed '/Exiting due to channel error/d' ) || :

# we must redirect all streams to /dev/null so ssh doesn't stay on..
firefox-hardened --start-debugger-server 6000 about:blank >/dev/null 2>&1 &
p=$!

for _ in {1..120}; do
	if nc -z localhost 6000 2>/dev/null; then
		break
	fi
	if ! kill -0 "$p" 2>/dev/null; then
		echo "firefox exited before its debugger server became available" >&2
		exit 1
	fi
	sleep 0.5
done
if ! nc -z localhost 6000 2>/dev/null; then
	echo "firefox debugger server did not become available" >&2
	exit 1
fi

# wait for the browser to initialize a bit..
sleep 5

timeout 30 python firefox/browsereval.py
ret=$?

# move the mouse elsewhere than the tab tooltip,
# otherwise Escape hides the tooltip instead of unfocus the search bar
xdotool mousemove 0 0
sleep 1
xdotool key Escape
sleep 1
urlbar='Services.wm.getMostRecentWindow("navigator:browser").gURLBar'
target='data:text/html,%3Ctitle%3EDemolinux%20browser%20test%3C/title%3E'
xdotool key --clearmodifiers ctrl+l
timeout 20 python firefox/browsereval.py --wait "$urlbar.focused && $urlbar.inputField.selectionStart === 0 && $urlbar.inputField.selectionEnd === $urlbar.inputField.value.length"
xdotool type --clearmodifiers "$target"
timeout 20 python firefox/browsereval.py --wait "$urlbar.value === '$target'"
xdotool key Enter
expectfocus 'Demolinux browser test — Mozilla Firefox' 30
xdotool key ctrl+w # remapped to deleteWordBackward in .vimfx/config.js
sleep 1
expectfocus 'Demolinux browser test — Mozilla Firefox'

quitwin
pkill firefox || :
