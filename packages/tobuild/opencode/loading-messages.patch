+function LoadingText(props: { text: string; offset: number }) {
+  const { theme } = useTheme()
+  const chars = createMemo(() => props.text.split(""))
+  return (
+    <text>
+      <Index each={chars()}>
+        {(char, i) => {
+          const color = createMemo(() => {
+            // Rolling sine wave gradient between textMuted and primary
+            const ratio = 0.5 + Math.sin(i * 0.3 - props.offset) * 0.5
+            return RGBA.fromInts(
+              Math.round((theme.textMuted.r + (theme.primary.r - theme.textMuted.r) * ratio) * 255),
+              Math.round((theme.textMuted.g + (theme.primary.g - theme.textMuted.g) * ratio) * 255),
+              Math.round((theme.textMuted.b + (theme.primary.b - theme.textMuted.b) * ratio) * 255),
+            )
+          })
+          return <span style={{ fg: color() }}>{char()}</span>
+        }}
+      </Index>
+    </text>
+  )
+}
