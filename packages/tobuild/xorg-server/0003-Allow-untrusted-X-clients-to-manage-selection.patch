+
+static SecuritySelectionWindowPtr
+SecurityFindSelectionWindow(XID requestor)
+{
+    SecuritySelectionWindowPtr window;
+
+    for (window = SecuritySelectionWindows; window; window = window->next)
+        if (window->requestor == requestor)
+            return window;
+    return NULL;
+}
+
+static SecuritySelectionTransferPtr
+SecurityFindSelectionTransfer(ClientPtr owner, XID requestor, Atom property)
+{
+    SecuritySelectionWindowPtr window = SecurityFindSelectionWindow(requestor);
+    SecuritySelectionTransferPtr transfer;
+
+    if (window)
+        for (transfer = window->transfers; transfer; transfer = transfer->next)
+            if ((!owner || transfer->owner == owner) &&
+                (property == None || transfer->property == property))
+                return transfer;
+    return NULL;
+}
+
+static void
+SecurityRemoveSelectionTransfer(XID requestor,
+                                SecuritySelectionTransferPtr transfer)
+{
+    SecuritySelectionWindowPtr window = SecurityFindSelectionWindow(requestor);
+    SecuritySelectionTransferPtr *link;
+
+    if (window)
+        for (link = &window->transfers; *link; link = &(*link)->next)
+            if (*link == transfer) {
+                *link = transfer->next;
+                free(transfer);
+                return;
+            }
+}
+
+static int
+SecurityDeleteSelectionWindow(void *value, XID id)
+{
+    SecuritySelectionWindowPtr window = value, *link;
+    SecuritySelectionTransferPtr transfer;
+
+    for (link = &SecuritySelectionWindows; *link; link = &(*link)->next)
+        if (*link == window) {
+            *link = window->next;
+            break;
+        }
+    while ((transfer = window->transfers)) {
+        window->transfers = transfer->next;
+        free(transfer);
+    }
+    free(window);
+    return Success;
+}
+
+static void
+SecurityGrantSelectionTransfer(ClientPtr owner, XID requestor, Atom selection,
+                               Atom target, Atom property, Atom group)
+{
+    SecuritySelectionWindowPtr window = SecurityFindSelectionWindow(requestor);
+    SecuritySelectionTransferPtr transfer;
+
+    if (property == None)
+        return;
+    if (!window) {
+        window = calloc(1, sizeof(*window));
+        if (!window)
+            return;
+        window->requestor = requestor;
+        window->next = SecuritySelectionWindows;
+        SecuritySelectionWindows = window;
+        /* FreeResource(requestor) also revokes grants when the window dies. */
+        if (!AddResource(requestor, RTSelectionWindow, window))
+            return;
+    }
+    transfer = SecurityFindSelectionTransfer(NULL, requestor, property);
+    if (!transfer) {
+        transfer = calloc(1, sizeof(*transfer));
+        if (!transfer)
+            return;
+        transfer->next = window->transfers;
+        window->transfers = transfer;
+    }
+    /* Reusing a transport property replaces its previous authorization. */
+    transfer->owner = owner;
+    transfer->selection = selection;
+    transfer->target = target;
+    transfer->property = property;
+    transfer->group = group;
+    transfer->incremental = transfer->complete = FALSE;
+}
+
+static void
+SecuritySelectionRequested(ClientPtr owner, WindowPtr ownerWindow, xEvent *event)
+{
+    WindowPtr requestor;
+    SecurityStateRec *subj, *obj;
+    PropertyPtr pairs;
+    Atom property;
+    CARD32 *atoms;
+    unsigned long i;
+
+    /* Only the server's genuine SelectionRequest can grant cross-client access. */
+    if (event->u.u.type != SelectionRequest ||
+        event->u.selectionRequest.owner != ownerWindow->drawable.id ||
+        dixLookupWindow(&requestor, event->u.selectionRequest.requestor,
+                        serverClient, DixGetAttrAccess) != Success)
+        return;
+    subj = dixLookupPrivate(&owner->devPrivates, stateKey);
+    obj = dixLookupPrivate(&wClient(requestor)->devPrivates, stateKey);
+    if (SecurityDoCheck(subj, obj, DixWriteAccess, 0) == Success)
+        return;
+
+    property = event->u.selectionRequest.property;
+    if (property == None)
+        property = event->u.selectionRequest.target;
+    SecurityGrantSelectionTransfer(owner, requestor->drawable.id,
+                                   event->u.selectionRequest.selection,
+                                   event->u.selectionRequest.target, property, property);
+
+    /* ICCCM MULTIPLE carries the requested target/property pairs in a property. */
+    if (event->u.selectionRequest.target == SecurityMultipleAtom &&
+        dixLookupProperty(&pairs, requestor, property, serverClient,
+                          DixReadAccess) == Success && pairs->format == 32) {
+        atoms = pairs->data;
+        for (i = 0; i + 1 < pairs->size; i += 2)
+            if (atoms[i + 1] != property)
+                SecurityGrantSelectionTransfer(owner, requestor->drawable.id,
+                                               event->u.selectionRequest.selection,
+                                               atoms[i], atoms[i + 1], property);
+    }
+}
+
+static Bool
+SecuritySelectionNotifyAllowed(ClientPtr owner, XID destination, xEvent *event)
+{
+    SecuritySelectionWindowPtr window;
+    SecuritySelectionTransferPtr transfer;
+
+    if ((event->u.u.type & ~SecuritySyntheticEventBit) != SelectionNotify ||
+        event->u.selectionNotify.requestor != destination)
+        return FALSE;
+    window = SecurityFindSelectionWindow(event->u.selectionNotify.requestor);
+    if (!window)
+        return FALSE;
+    for (transfer = window->transfers; transfer; transfer = transfer->next)
+        if (transfer->owner == owner &&
+            transfer->selection == event->u.selectionNotify.selection &&
+            transfer->target == event->u.selectionNotify.target &&
+            (event->u.selectionNotify.property == None ||
+             transfer->property == event->u.selectionNotify.property)) {
+            if (event->u.selectionNotify.property == None) {
+                SecuritySelectionTransferPtr *link = &window->transfers, failed;
+                Atom group = transfer->group;
+
+                /* A failed MULTIPLE reply also revokes its component grants. */
+                while ((failed = *link))
+                    if (failed->owner == owner && failed->group == group) {
+                        *link = failed->next;
+                        free(failed);
+                    }
+                    else
+                        link = &failed->next;
+            }
+            return TRUE;
+        }
+    return FALSE;
+}
+
+static void
+SecuritySelectionEvent(CallbackListPtr *pcbl, void *unused, void *calldata)
+{
+    EventInfoRec *rec = calldata;
+    WindowPtr ownerWindow;
+    int i;
+
+    /* ConvertSelection delivers directly, bypassing XACE_RECEIVE_ACCESS. */
+    for (i = 0; i < rec->count; i++)
+        if (rec->events[i].u.u.type == SelectionRequest &&
+            dixLookupWindow(&ownerWindow, rec->events[i].u.selectionRequest.owner,
+                            serverClient, DixGetAttrAccess) == Success)
+            SecuritySelectionRequested(rec->client, ownerWindow, &rec->events[i]);
 }

