+
+        const listResult = await list.execute({}, ctx)
+        expect(listResult.metadata.processes).toHaveLength(1)
+        expect(listResult.metadata.processes[0].id).toBe(id)
+        expect(listResult.metadata.processes[0].title).toBe("Test Sleep")
