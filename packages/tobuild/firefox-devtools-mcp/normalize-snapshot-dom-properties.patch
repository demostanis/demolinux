+function getStringProperty(el: Element, property: 'value' | 'href' | 'src'): string | undefined {
+  const value: unknown = (el as unknown as Record<string, unknown>)[property];
+  if (typeof value === 'string') {
+    return value;
+  }
+  if (typeof value === 'number' || typeof value === 'boolean') {
+    return String(value);
+  }
+  // SVG href is an SVGAnimatedString, not an HTML URL string.
+  if (value && typeof value === 'object' && 'baseVal' in value) {
+    return typeof value.baseVal === 'string' ? value.baseVal : undefined;
+  }
+  return undefined;
+}
