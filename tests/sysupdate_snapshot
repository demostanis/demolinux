#!/bin/bash

set -ex

echo rebooting to check created snapshot..

qmp(){
	nc -q0 localhost "${DEMOLINUX_QMP_PORT:-4444}" >/dev/null
}
cap(){
	echo '{"execute":"qmp_capabilities"}'
}
key(){
	echo '{"execute":"send-key","arguments":{"keys":[{"type":"qcode","data":"'"$1"'"}]}}'
}

(
	cap
	sleep 0.2
	key down
	sleep 0.2
	key down
	sleep 0.2
	key down
	sleep 0.2
	key ret
	sleep 2
	key ret
) | qmp

echo connecting through ssh...
connected=
for _ in {1..120}; do
	if timeout 5 ./dctrl shell "grep -q demolinux /etc/os-release" 2>/dev/null; then
		connected=y
		break
	fi
	sleep 1
done
[ -n "$connected" ] || { echo snapshot did not boot >&2; exit 1; }
timeout 10 ./dctrl shell "cat /version >/dev/null"
timeout 10 ./dctrl shell "grep -Eq '(^| )btrfs_snapshot=[^ ]*/snapshot-[0-9]{8}-[0-9]{6}( |$)' /proc/cmdline"
timeout 10 ./dctrl shell "sudo poweroff" || :
