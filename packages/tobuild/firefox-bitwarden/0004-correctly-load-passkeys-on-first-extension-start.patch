+  /**
+   * Reloads the given tab.
+   *
+   * @param tabId The id of the tab to reload
+   */
+  static async reloadTab(tabId: number): Promise<void> {
+    if (!tabId) {
+      return;
+    }
+
+    if (BrowserApi.isWebExtensionsApi) {
+      await browser.tabs.reload(tabId).catch((error) => {
+        throw new Error("[BrowserApi] Failed to reload tab: " + error.message);
+      });
+      return;
+    }
+
+    if (BrowserApi.isChromeApi) {
+      await chrome.tabs.reload(tabId).catch((error) => {
+        throw new Error("[BrowserApi] Failed to reload tab: " + error.message);
+      });
+    }
+  }
+
   /**
    * Navigates a browser tab to the given URL
    *
@@ -815,7 +839,13 @@ export class BrowserApi {
   static async registerContentScriptsMv2(
     contentScriptOptions: browser.contentScripts.RegisteredContentScriptOptions,
   ): Promise<browser.contentScripts.RegisteredContentScript> {
-    if (typeof browser !== "undefined" && !!browser.contentScripts?.register) {
+    // Firefox's native browser.contentScripts.register() does not inject into tabs
+    // that are already open when the extension loads (e.g., restored session tabs).
+    // The polyfill handles this by listening to chrome.tabs.onUpdated and
+    // chrome.webNavigation.onCommitted, ensuring FIDO2 scripts are injected into
+    // all matching pages including restored tabs.
+    const isFirefox = navigator.userAgent.indexOf("Firefox/") !== -1;
+    if (!isFirefox && typeof browser !== "undefined" && !!browser.contentScripts?.register) {
       return await browser.contentScripts.register(contentScriptOptions);
     }
 
