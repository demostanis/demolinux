     "DRI3",
     "SYNC",
@@ -950,6 +952,11 @@

     if (!IsKeyboardDevice(rec->dev))
         allowed = requested;
+    else if (requested == (DixReadAccess | DixReceiveAccess)) {
+        WindowPtr focus = SecurityKeyboardFocus(rec->dev);
+        if (focus && wClient(focus) == rec->client)
+            allowed = requested;
+    }
     else if (requested & DixGrabAccess) {
         WindowPtr focus = SecurityKeyboardFocus(rec->dev);

@@ -1044,6 +1051,27 @@
     rec->status = BadAccess;    /* deny access */
 }

+static Bool
+SecurityXkbRequestAllowed(ClientPtr client)
+{
+    switch (client->minorOp) {
+    case X_kbUseExtension:
+    case X_kbSelectEvents:
+    case X_kbGetState:
+    case X_kbGetControls:
+    case X_kbGetMap:
+    case X_kbGetCompatMap:
+    case X_kbGetIndicatorMap:
+    case X_kbGetNames:
+    case X_kbGetGeometry:
+    case X_kbPerClientFlags:
+    case X_kbListComponents:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
 static void
 SecurityExtension(CallbackListPtr *pcbl, void *unused, void *calldata)
 {
@@ -1057,8 +1085,14 @@
         return;

     while (SecurityTrustedExtensions[i])
-        if (!strcmp(SecurityTrustedExtensions[i++], rec->ext->name))
+        if (!strcmp(SecurityTrustedExtensions[i++], rec->ext->name)) {
+            /* XKB metadata is available, but global keyboard changes are not. */
+            if (!strcmp(rec->ext->name, "XKEYBOARD") &&
+                rec->access_mode == DixUseAccess &&
+                !SecurityXkbRequestAllowed(rec->client))
+                break;
             return;
+        }

     SecurityAudit("Security: denied client %d access to extension "
                   "%s on request %s\n",
